{% extends "_layout/base-layout.html.twig" %}

{% block  header_title %} {{ __('portfolio_manager') }} {% endblock header_title %}

{% block  header_nav %}
    <ul class="nav nav-list nav-list-topbar"> 
        <li class=""><a href="{{ router('admin.portfolio.index') }}">{{ __('portfolio_list') }} </a> </li>
        <li class="{% if id is not defined %} active {% endif %}"><a href="{{ router('admin.portfolio.create') }}">{{ __('portfolio_add') }} </a> </li> 
    </ul>
{% endblock header_nav %}

{% block  content %}  
	<style>
		.fancybox-slide--iframe .fancybox-content {
			width  : 800px;
			height : 600px;
			max-width  : 80%;
			max-height : 80%;
			margin: 0;
		}
	</style>
	<script src="https://api-maps.yandex.ru/2.1/?lang=ru_RU&amp;apikey=a1bef2f6-2d8a-4fbe-9d47-e77da8849296" type="text/javascript"></script>
	{{ assets({files: ['@portfolio_/resources/js/map.js']}) }}
	<div id="content" class="">
		<div class="panel panel-dark panel-border top">
			<div class="panel-heading"><span class="panel-title">{{ title }}</span></div>
			<div class="panel-body admin-form">
				<form id="admin-form" action="{% if id is defined %} {{ router('admin.portfolio.'~ type, id) }} {% else %} {{ router('admin.portfolio.'~ type) }} {% endif %}" method="post"  class="form-horizontal parsley-form">
					{% if id is defined %}
					<input name="_method" type="hidden" value="PUT">
					{% endif %}
					<div class="row form-group mb-3 align-items-center">
						<label for="category" class="col-lg-3 control-label text-end">{{ __('portfolio_editor_category') }}</label>
						<div class="col-lg-4">
								<label class="field select">
									<select class="form-control" name="category" id="category">
										{% for cat in categories %} 											
										  	<option value="{{ cat.id }}" {% if data.category == cat.id  %} selected {% endif %}>{{ cat.name }}</option>
										{% endfor %}  
									</select><i class="arrow double"></i>
								</label>
						</div>
					</div>
					<div class="row form-group mb-3 align-items-center">
						<label for="title" class="col-lg-3 control-label text-end">{{ __('portfolio_editor_title') }}</label>
						<div class="col-lg-4">
							<label for="title" class="field prepend-icon">
								<input id="title" type="text" name="title" value="{{ data.title }}" placeholder="{{ __('portfolio_editor_title_placeholder') }}" class="gui-input" />
								<label for="title" class="field-icon"><i class="far fa-pencil"></i></label>
							</label>
						</div>
					</div> 
					<div class="row form-group mb-3 align-items-center">
						<label for="subtitle" class="col-lg-3 control-label text-end">{{ __('portfolio_editor_subtitle') }}</label>
						<div class="col-lg-4">
							<label for="subtitle" class="field prepend-icon">
								<input id="subtitle" type="text" name="subtitle" value="{{ data.subtitle }}" placeholder="{{ __('portfolio_editor_subtitle_placeholder') }}" class="gui-input" />
								<label for="subtitle" class="field-icon"><i class="far fa-pencil"></i></label>
							</label>
						</div>
					</div> 
					<div class="row form-group mb-3 align-items-center">
						<label for="slug" class="col-lg-3 control-label text-end">{{ __('portfolio_editor_slug') }}</label>
						<div class="col-lg-4">
							<label for="slug" class="field prepend-icon">
								<input id="slug" type="text" name="slug" value="{{ data.slug }}" placeholder="{{ __('portfolio_editor_slug_placeholder') }}" class="gui-input" />
								<label for="slug" class="field-icon"><i class="far fa-link"></i></label>
							</label>
						</div>
					</div>
					<div class="row form-group mb-3 align-items-center">
						<label for="address" class="col-lg-3 control-label text-end">{{ __('portfolio_editor_address') }}</label>
						<div class="col-lg-4">				
							<input name="address" id="address" type="text" class="gui-input mb-3" placeholder="{{ __('portfolio_editor_address_placeholder') }}" value="{{ data.address }}" />
							<input type="hidden" name="coord" id="coord">
							<div id="map" style="width: 100%; height: 300px;"></div>
						</div>
			 		</div>
					<div class="row form-group mb-3 align-items-center">
						<label for="category" class="col-lg-3 control-label text-end">{{ __('portfolio_editor_preview') }}</label>	
						<div class="col-lg-4">							
							<label for="preview" class="field  prepend-icon smart-widget sm-right">
								<input id="preview" type="text" name="preview" placeholder="{{ __('portfolio_editor_preview_placeholder') }}" class="gui-input" value="{{ data.preview.full }}" />
								<label for="preview" class="field-icon"><i class="far fa-file-image"></i></label>
								<a class="button" type="button" data-fancybox="" data-type="iframe" data-src="/filemanager/filemanager.php?type=1&amp;field_id=preview&amp;relative_url=0&amp;fldr=portfolio" href="javascript:;"><i class="fas fa-folder-open"></i></a>
							</label>		
						</div>				
					</div>			
					<div class="row form-group mb-3 align-items-center">
						<label for="category" class="col-lg-3 control-label text-end">{{ __('portfolio_editor_gallery') }}</label>	
						<div class="col-lg-4">							
							<label for="gallery" class="field  prepend-icon smart-widget sm-right">
								<input id="gallery" type="text" name="gallery" placeholder="{{ __('portfolio_editor_gallery_placeholder') }}" class="gui-input" value="{{ gallery }}" />
								<label for="gallery" class="field-icon"><i class="far fa-file-image"></i></label>
								<a class="button" type="button" data-fancybox="" data-type="iframe" data-src="/filemanager/filemanager.php?type=1&amp;field_id=gallery&amp;relative_url=0&amp;fldr=portfolio" href="javascript:;"><i class="fas fa-folder-open"></i></a>
							</label>		
						</div>				
					</div>			
					<div class="row form-group mb-3 align-items-center">
						<label for="media" class="col-lg-3 control-label text-end">{{ __('portfolio_editor_media') }}</label>
						<div class="col-lg-4">
							<label for="media" class="field prepend-icon">
								<input id="media" type="text" name="media" value="{{ data.media }}" placeholder="{{ __('portfolio_editor_media_placeholder') }}" class="gui-input" />
								<label for="media" class="field-icon"><i class="far fa-link"></i></label>
							</label>
						</div>
					</div>
					<div class="row form-group mb-3 align-items-center">
						<label for="tags" class="col-lg-3 control-label text-end">{{ __('portfolio_editor_tags') }}</label>
						<div class="col-lg-4">
							<label for="tags" class="field prepend-icon">
								<input id="tags" type="text" name="tags" value="{{ data.tags|join(',') }}" placeholder="{{ __('portfolio_editor_tags_placeholder') }}" class="gui-input" />
								<label for="tags" class="field-icon"><i class="far fa-link"></i></label>
							</label>
						</div>
					</div>
					
					<div class="row form-group mb-3 align-items-center">
						<label class="col-sm-3 control-label text-end">{{ __('portfolio_editor_description') }}</label>
						<div class="col-sm-4">
							<label for="description" class="field prepend-icon">
								<textarea name="description" id="description" placeholder="{{ __('portfolio_editor_description_placeholder') }}" class="gui-textarea">{{ data.description }}</textarea>
								<label for="description" class="field-icon"><i class="far fa-comments"></i></label>
							</label>
						</div>
					</div>	
					<script src="https://cdnjs.cloudflare.com/ajax/libs/tinymce/5.8.2/tinymce.min.js" referrerpolicy="origin"></script>
					<script>
						tinymce.init({
							selector: 'textarea#full'
						});
					</script>		
					<div class="row form-group mb-3 align-items-center">
						<label class="col-sm-3 control-label text-end">{{ __('portfolio_editor_full') }}</label>
						<div class="col-sm-8">
							<textarea name="full" id="full" placeholder="{{ __('portfolio_editor_full_placeholder') }}">{{ data.full }}</textarea>
						</div>
					</div>			
					<div class="row form-group">
						<label class="col-sm-3 control-label"></label>
						<div class="col-sm-4">
							<input name="submit" type="submit" class="btn btn-primary btn-parsley" value="{{ do }}">
						</div>
					</div>
				</form>
			</div>
		</div>
    </div>
{% endblock content %}