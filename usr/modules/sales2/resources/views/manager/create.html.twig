{% block  header_title %}{% endblock header_title %}

{% block  header_nav %}
	{{ include('@sales2/manager/nav_list.html.twig') }}
{% endblock header_nav %}

{% block scripts %}
	<script>
		{{ oid.js|raw }}
{{ object.js|raw }}
	</script>
	{{oid_create.script|raw}}
	{{object_create.script|raw}}
