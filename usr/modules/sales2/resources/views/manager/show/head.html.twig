<div class="row">
	<div class="col-5">
		<div class="holder-container" :style="headButtons.style" id="head-buttons">
			<div :class="{'holder-style': true, 'holder-active': is_checked}" @click="placeOrderModal">
				<i class="fa fa-edit holder-icon"></i>Разместить заказ
			</div>
			<div :class="{'holder-style': true, 'holder-active': is_checked}"  @click="transferModal" v-if="sales.sales_type == 2">
				<i class="fas fa-truck holder-icon holder-icon"></i>Создать перемещение
			</div>
			<div :class="{'holder-style': true, 'holder-active': is_checked}"  @click="realizationModal" v-else>
				<i class="fa fa-check-circle holder-icon"></i>Создать реализацию
			</div>
			<div class="holder-style holder-active" @click="printModal">
				<i class="glyphicon glyphicon-print holder-icon"></i>Вывести на печать
			</div>
			<div class="holder-style holder-active" @click="showCommentModal">
				<span class="holder-icon fw-bold">${comments_count}</span>Комментарии
			</div>
			<div class="holder-style holder-active" @click="sendMessageModal">
				<i class="fas fa-envelope holder-icon"></i>Отправить сообщение
			</div>
			<div class="holder-style holder-active" @click="endSalesModal" v-if="sales.end == 0 || sales.end == 3">
				<i class="fas fa-flag-checkered holder-icon"></i>Закрыть продажу
			</div>
			<div class="holder-style holder-active" @click="endSalesZeroModal" v-else>
				<i class="fas fa-flag-checkered holder-icon"></i>Возродить продажу
			</div>
			{# <div class="holder-style holder-active">
				<i class="fas fa-umbrella holder-icon"></i>Объединить товары
			</div> #}
			{# <div :class="{'holder-style': true, 'holder-active': is_checked}" @click="assemblyModal">
				<i class="fas fa-box-open holder-icon"></i>Отправить на сборку
			</div> #}
			<div class="holder-style holder-active" @click="sortModal">
				<i class="fas fa-sort-numeric-down holder-icon"></i>Сортировка
			</div>
			<div class="holder-style holder-active" @click="usersModal">
				<i class="fas fa-users-cog holder-icon"></i>Пользователи продажи
			</div>
			<div class="holder-style holder-active" @click="append_chat">
				<i class="fas fa-comment-medical holder-icon"></i>Добавиться в чат
			</div>
			{# <div class="holder-style holder-active" v-if="sales.clone_active">
				<i class="far fa-handshake holder-icon"></i>Перепродажа на склад партнёра
			</div> #}
			<div class="holder-style holder-active" v-if="sales.clone_active" @click="move_clone">
				<i class="fas fa-ghost holder-icon"></i>Ссылка на клона
			</div>
		</div>
		{# <div class="cp mt-3 d-flex justify-content-center" @click="toggleHeadButtons">
			<i class="fas fa-angle-down" v-if="headButtons.flag"></i>
			<i class="fas fa-angle-up" v-else></i>
		</div> #}
	</div>
	<div class="col-7">
		<div class="row">
			<div class="col">
				<div>
					<small>Контрагент:</small>
					<div class="fw-bold">
						<span @click="modals.organizationModal.modal.show()" class="cp">${sales.organization?.name ?? "Не указан"}</span>
						<span class="fa fa-external-link text-primary cp ms-1" v-if="sales.oid" @click="redirectOrganization" title="Перейти в организацию"></span>
						<i class="fas fa-exchange cp text-primary ms-2" title="Изменить" @click="modals.changeOidModal.modal.show()"></i>
					</div>
				</div>
				<div class="mt-2">
					<small>Ответственный:</small>
					<div class="fw-bold">
						${sales.user?.short_user_name ?? "Не указан"}
						<i class="fas fa-exchange cp text-primary ms-1" title="Изменить" @click="modals.changeUidModal.modal.show()"></i>
					</div>
				</div>
				<div class="mt-2">
					<small>Менеджер сопровождения:</small>
					<div class="fw-bold">
						${sales.user_maintenance?.short_user_name ?? "Не указан"}
						<i class="fas fa-exchange cp text-primary ms-1" title="Изменить" @click="modals.changeUidMaintenanceModal.modal.show()"></i>
					</div>
				</div>
				<div class="mt-2">
					<small>Объект:</small>
					<div class="fw-bold">
						${sales.object_?.name ?? "Не указан"}
						<i class="fas fa-exchange cp text-primary ms-1" title="Изменить" @click="modals.changeObjectModal.modal.show()"></i>
					</div>
				</div>
				<div class="mt-2">
					<small>Договор:</small>
					<div class="fw-bold">
						<span v-html="sales.contract.view_new"></span>
						<i class="fas fa-exchange cp text-primary ms-1" title="Изменить" @click="contractModal" v-if="sales.oid"></i>
					</div>
				</div>
				<div class="mt-2" v-if="sales.contract.exists">
					<small>Спецификация:</small>
					<div class="fw-bold">
						<span v-html="sales.specification.view"></span>
						<i class="fas fa-exchange cp text-primary ms-1" title="Изменить" v-if="!sales.specification.exists" @click="modals.specificationModal.modal.show()"></i>
					</div>
				</div>
			</div>
			<div class="col">
				<div>
					<small>Дата подачи заявки:</small>
					<div>
						<span class="fw-bold" id="date" data-pk="{{id}}" data-value="{{sales.date}}"></span>
					</div>
				</div>
				<div class="mt-2">
					<small>Сумма заказа:</small>
					<div class="fw-bold" id="total">${nf(sales.total)}</div>
				</div>
				<div class="mt-2">
					<small>Статус клиента:</small>
					<div class="fw-bold">{{sales.statusClientView}}</div>
				</div>
				<div class="mt-2">
					<small>Тип продажи:</small>
					<div>
						<span class="fw-bold" id="sales_type" data-pk="{{id}}" data-value="{{sales.sales_type}}" data-source="{{sales_type_source|json_encode()}}">{{sales.salesTypeView}}</span>
					</div>
				</div>
			</div>
			<div class="col">
				<div>
					<small>Оплата:</small>
					<div class="fw-bold cp
					{% if sales.pay == 0 %}text-danger{% endif %}
					{% if sales.pay == 1 %}text-warning{% endif %}
					{% if sales.pay == 2 %}text-success{% endif %}
					" @click="pay_modal">{{sales.pay_view}}</div>
				</div>
				<div class="mt-2">
					<small>Организация:</small>
					<div>
						<span class="fw-bold" id="org" data-pk="{{id}}" data-value="{{sales.org}}" data-source="{{org_source|json_encode()}}">{{sales.org_.organization.name}}</span>
					</div>
				</div>
				<div class="mt-2">
					<small>Склад:</small>
					<div>
						<span class="fw-bold" id="stock_id" data-pk="{{id}}" data-value="{{sales.stock_id}}" data-source="{{stock_source|json_encode()}}"></span>
					</div>
				</div>
				<div class="mt-2">
					<small>Склад отображения:</small>
					<div>
						<span class="fw-bold" id="stock_view" data-pk="{{id}}" :data-value="sales.stock_id_view" data-source="{{stock_view_source|json_encode()}}"></span>
						<i class="fas fa-times ms-3 text-danger cp" v-if="sales.stock_id != sales.stock_id_view" @click="reset_stock_id_view"></i>
					</div>
				</div>
			</div>
			<div class="col">
				<div>
					<small>Источник обращения:</small>
					<div>
						<span class="fw-bold" id="source_appeal" data-pk="{{id}}" data-value="{{sales.source_appeal}}" data-source="{{source_appeal_source|json_encode()}}">{{sales.SourceAppealView ?? "Не указано"}}</span>
					</div>
				</div>
				<div class="mt-2">
					<small>Сегмент рынка:</small>
					<div>
						<span class="fw-bold" id="market_segment" data-pk="{{id}}" data-value="{{sales.market_segment}}" data-source="{{market_segment_source|json_encode()}}">{{sales.MarketSegmentView ?? "Не указано"}}</span>
					</div>
				</div>
				<div class="mt-2">
					<small>По сфере деятельности:</small>
					<div>
						<span class="fw-bold" id="by_field_activity" data-pk="{{id}}" data-value="{{sales.by_field_activity}}" data-source="{{by_field_activity_source|json_encode()}}">{{sales.ByFieldActivityView ?? "Не указано"}}</span>
					</div>
				</div>
				<div class="mt-2">
					<small>Категория продажи:</small>
					<div>
						<span class="fw-bold" id="sales_cat" data-pk="{{id}}" data-value="{{sales.sales_cat}}" data-source="{{sales_cat_source|json_encode()}}">{{sales.SalesCatView ?? "Не указано"}}</span>
					</div>
				</div>
			</div>
		</div>
		<div class="row mt-3">
			<div class="col">
				<div v-if="sales.end == 2 || sales.end == 1">
					<div>Комментарий завершения заказа:</div>
					<b :class="{'text-success': sales.end == 1, 'text-danger': sales.end == 2}">${sales.comment_end}</b>
				</div>
			</div>
			<div class="col"></div>
		</div>
	</div>
</div>
