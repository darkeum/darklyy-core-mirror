<table class="table table-striped" id="sales_table">
	<thead id="sales_table_thead" class="table-light">
		<tr>
			<th>№</th>
			<th>Номенклатура</th>
			<th class="cp" @click="bodySwitch[0] = !bodySwitch[0]" nowrap>
				<div class="d-flex align-items-center">
					<div>
						<div v-if="bodySwitch[0]">Артикул</div>
						<div v-if="!bodySwitch[0]">Ед. изм.</div>
					</div>
					<i class="text-primary fas fa-sync-alt ms-3"></i>
				</div>
			</th>
			<th>Кол-во</th>
			<th class="cp" @click="bodySwitch[1] = !bodySwitch[1]">
				<div class="d-flex align-items-center" gap-3>
					<div style="width: min-content;">
						<div v-if="bodySwitch[1]">
							<template v-if="sales.sales_type == 2">Кол. пер.</template>
							<template v-else>Кол. реал.</template>
						</div>
						<div v-if="!bodySwitch[1]">Кол. собр.</div>
					</div>
					<i class="text-primary fas fa-sync-alt"></i>
				</div>
			</th>
			<th>Н/Д/Р</th>
			<th class="cp">
				<div class="d-flex align-items-center gap-2">
					<div><input type="checkbox" id="purchase_price_hide" v-model="purchase_price_hide" @change="purchase_price_hide_change" title="Скрыть цену закупки"></div>
					<div class="d-flex align-items-center gap-3" @click="changePurchasePrice(2, 3)">
						<div style="width: min-content;">
							<div v-if="bodySwitch[2] == 0">Цена закупки</div>
							<div v-if="bodySwitch[2] == 1">Сумма закупки</div>
							<div v-if="bodySwitch[2] == 2">Разница</div>
						</div>
						<i class="text-primary fas fa-sync-alt"></i>
					</div>
				</div>
			</th>
			<th>Тип цены</th>
			<th class="cp" @click="bodySwitch[3] = !bodySwitch[3]">Цена
				<span v-if="!bodySwitch[3]">со скидкой</span>
				<span class="badge badge-dark ms-1">
					<span v-if="sales.nds_includes == 1">С</span>
					<span v-if="sales.nds_includes == 0">БЕЗ</span>
					НДС
				</span>
				<i class="text-primary fas fa-sync-alt ms-2"></i>
			</th>
			<th>Скидка</th>
			<th>Сумма
				<span class="badge badge-dark ms-1">
					<span v-if="sales.nds_includes == 1">С</span>
					<span v-if="sales.nds_includes == 0">БЕЗ</span>
					НДС
				</span>
			</th>
			<th class="cp" @click="bodySwitch[4] = !bodySwitch[4]">
				<div class="d-flex align-items-center gap-3">
					<div style="width: min-content;">
						<div v-if="bodySwitch[4]">Комментарий</div>
						<div v-if="!bodySwitch[4]">Дата поставки</div>
					</div>
					<i class="text-primary fas fa-sync-alt"></i>
				</div>
			</th>
			<th>Статус</th>
			<th>Резерв</th>
			<th nowrap>Дата поставки</th>
			<th>
				<span class="badge badge-dark" title="Действия">A</span>
			</th>
			<th>
				<div class="checkbox-custom mb15">
					<input id="all" type="checkbox" class="checks" @change="checkbox_all();" v-model="sales.checkbox">
					<label for="all"></label>
				</div>
			</th>
		</tr>
	</thead>
	<tbody id="sales_table_tbody">
		<template v-for="(item, index) in sales_detail" :key="item.uniqid">
			<tr v-if="!item.delete_" :class="item.class">

				{# position #}
				<td class="position" :title="`id: ${item.id}; cid: ${item.cid}`" style="cursor: move;">${item.position}</td>

				{# s_name #}
				<td style="width=300px;" @dblclick="replaceGoods(index)" class="cp">${item.s_name}</td>

				{# s_sku #}
				<td>
					<div v-if="bodySwitch[0]">${item.s_sku}</div>
					<div v-if="!bodySwitch[0]">${item.unit_name}</div>
				</td>

				{# count #}
				<td class="text-center" @click="edit_count(index)" style="width:80px">
					<div class="cp" v-show="!item.count_edit">${item.count}</div>
					<div v-show="item.count_edit">
						<input type="number" v-model="item.count" @blur="save_count(item)" @keyup.enter="save_count(item)" ref="count_edit" class="form-control">
					</div>
				</td>

				{# count_realization #}
				<td class="text-center modules-count" style="width: 60px;">
					<div v-if="bodySwitch[1]">
						<template v-if="sales.sales_type == 2">
							<div class="cp" @click="view_modal(index, 'Перемещения', '{{route('admin.sales.ajax.get_transfer_sales', '@id')}}')">
								${item.count_transfer ?? 0}
							</div>
						</template>
						<template v-else>
							<div 
								:class="{'cp': true, 'text-bold': true,
									'text-danger': item?.count_realization == 0 || item?.count_realization == undefined, 
									'text-warning': (item?.count_realization > 0 && item?.count_realization < item.count),
									'text-success': (item?.count_realization == item.count),
								}" 
								@click="view_modal(index, 'Реализации', '{{route('admin.sales.ajax.get_realization_sales', '@id')}}')">
								${item.count_realization ?? 0}
							</div>
						</template>
					</div>
					<div v-if="!bodySwitch[1]">0</div>
				</td>

				{# ndr #}
				<td class="ndr" @click="view_ndr_modal(item)" nowrap>
					<template v-if="item.ndr.load">
						<div class="text-center">
							<div class="spinner-border spinner-border-sm" role="status"></div>
						</div>
					</template>
					<template v-else><span v-html="item.ndr.view"></span></template>
				</td>

				{# purchase #}
				<td nowrap style="width: 115px;">
						<div v-if="purchase_price_hide">
							<div class="text-center" v-if="item.purchase.load">
								<div class="spinner-border spinner-border-sm" role="status"></div>
							</div>
							<template v-else>
								<div>
									<div v-if="bodySwitch[2] == 0" :style="{color: item.purchase.color}" :class="{'fw-bold':checkPurchaseFile(item), 'cp':checkPurchaseFile(item)}" 	@click="checkPurchaseFile(item) ? openPurchaseFile(item) : ''">
										${nf(item.purchase.price)}
										<i class="fas fa-exchange cp text-primary ms-1" title="Изменить" @click="local_price_modal(index)"></i>
									</div>
									<div v-if="bodySwitch[2] == 1">${nf(item.purchase.price * item.count)}</div>
									<div v-if="bodySwitch[2] == 2">${nf(item.total - item.purchase.price * item.count)}</div>
								</div>
								<div>
									${item.purchase.date}
								</div>
							</template>
						</div>
						<div v-else class="text-center">-</div>
					</div>
				</td>

				{# price_type #}
				<td style="width: 130px;" @mouseover="item.price_type_edit = true" @mouseleave="item.price_type_edit = false">
					<div v-show="!item.price_type_edit">
						${sales.price_type_list[item.price_type].title}
					</div>
					<div v-show="item.price_type_edit">
						<select v-html="item.price_type_option_" class="form-select" v-model="item.price_type" @change="price_type_select(item)">
						</select>
					</div>
				</td>

				{# s_price #}
				<td nowrap style="width:130px" :title="`Максимально допустимая скидка: ${item.max_allowable_discount ?? '-'}`">
					<div v-if="bodySwitch[3]" @click="edit_price(index)">
						<div class="cp" v-show="!item.price_edit">${nf(item.s_price)}</div>
						<div v-show="item.price_edit">
							<input type="number" v-model="item.s_price" @blur="save_price(item)" @keyup.enter="save_price(item)" ref="price_edit" class="form-control">
						</div>
					</div>
					<div v-if="!bodySwitch[3]">${nf(item.total / item.count)}</div>
				</td>

				{# discount #}
				<td @click="edit_discount(index)" nowrap style="width:80px">
					<div class="cp" v-show="!item.discount_edit">${nfp(item.discount)}</div>
					<div v-show="item.discount_edit">
						<input type="number" v-model="item.discount" @blur="save_discount(item)" @keyup.enter="save_discount(item)" ref="discount_edit" class="form-control">
					</div>
				</td>

				{# total #}
				<td @click="edit_total(index)" nowrap style="width:120px">
					<div class="cp" v-show="!item.total_edit">${nf(item.total)}</div>
					<div v-show="item.total_edit">
						<input type="number" v-model="item.total" @blur="save_total(item)" @keyup.enter="save_total(item)" ref="total_edit" class="form-control">
					</div>
				</td>

				{# comment #}
				<td style="width: 130px;">
					<div v-if="bodySwitch[4]">
						<div style="width: 130px;" v-if="item.comment" @click="commentShowItemModal(item)" class="cp text-truncate">${item.comment}</div>
						<div v-else>Не указано</div>
					</div>
					<div style="width: 130px;" class="text-truncate" v-if="!bodySwitch[4]" @mouseover="item.local_date_delivery_edit = true" @mouseleave="item.	local_date_delivery_edit = false">
						<div class="cp" v-show="!item.local_date_delivery_edit">${sales.local_date_delivery_list[item.local_date_delivery] ?? `Не указано`}</div>
						<div v-show="item.local_date_delivery_edit" >
							<select class="form-select" v-model="item.local_date_delivery" @change="item.update_ = true">
								{% for item in sales.local_date_delivery_select %}
									<option value="{{item.index}}">{{item.name}}</option>
								{% endfor %}
							</select>
						</div>
					</div>
				</td>

				{# status #}
				<td class="text-center cp status" @click="showStatus(item)" v-html="item.status_view.span"></td>

				{# reserve #}
				<td class="text-center">
					<template v-if="item.ndr.load">
						<div class="spinner-border spinner-border-sm" role="status"></div>
					</template>
					<template v-else>
						<span v-if="item.ndr.data.r_this == 0 && item.ndr.data.r_after_this == 0" class="text-danger reserveNumber" aria-hidden="true" title="Резерв пуст">0</span>
						<span v-if="item.ndr.data.r_this > 0" class="text-success reserveNumber" aria-hidden="true" title="Резерв">${item.ndr.data.r_this}</span>
						<span v-if="item.ndr.data.r_this > 0 && item.ndr.data.r_after_this > 0" class="reserveNumber">+</span>
						<span v-if="item.ndr.data.r_after_this > 0" class="text-warning reserveNumber" aria-hidden="true" title="Резерв по поступлению">${item.ndr.data.r_after_this}</span>
					</template>
				</td>

				{# date_post #}
				<td>${item.date_post_view ?? "Не указано"}</td>

				{# action #}
				<td>
					<div class="btn-group">
					  <div class="btn-group dropstart" role="group">
					    <button type="button" class="btn btn-dark dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
					      <span class="visually-hidden">Toggle Dropstart</span>
					    </button>
					    <ul class="dropdown-menu">
					      	<li><a class="dropdown-item cp" @click.prevent="reserve_item(index)">Резерв</a></li>
							<li><a class="dropdown-item cp" @click.prevent="reserve_modal_item(index, `create`)">Добавить резерв (доп)</a></li>
							<li><a class="dropdown-item cp" @click.prevent="reserve_modal_item(index, `delete`)">Удалить резерв (доп)</a></li>
							<li><a class="dropdown-item cp" @click.prevent="modal_files_item(index)" v-if="item.catalog.attach_id.length > 0">Приложенные файлы</a></li>
							<li><a class="dropdown-item cp" @click.prevent="commentEditItemModal(item)">Комментарий</a></li>
							<li class="divider"></li>
							<li><a class="dropdown-item cp" @click.prevent="delete_item_modal(index)">Удалить</a></li>
					    </ul>
					  </div>
					</div>
				</td>

				{# checkbox #}
				<td>
					<div class="checkbox-custom mb15">
						<input :id="'checkbox'+index" type="checkbox" class="checks" v-model="item.checkbox" :value="item.id" :data-cid="item.cid">
						<label :for="'checkbox'+index"></label>
					</div>
				</td>

			</tr>
		</template>
	</tbody>
	<tfoot id="sales_table_tfoot" class="table-light">
		<tr>
			<td class="text-end fw-bold" colspan="6">Итого:</td>
			<td class="fw-bold">
				<div v-if="purchase_price_hide">${nf(sales.purchase[ bodySwitch[2] ])}</div>
				<div v-else class="text-center">-</div>
			</td>
			<td colspan="2"></td>
			<td class="text-end fw-bold">Итого:</td>
			<td class="fw-bold" colspan="7">${nf(sales.total)}</td>
		</tr>
		<tr>
			<td class="text-end fw-bold" colspan="10">НДС:</td>
			<td class="fw-bold" colspan="7">${nf(sales.nds)}</td>
		</tr>
	</tfoot>
</table>