{# reserve modal #}
<div class="modal fade" id="reserveModal" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<form @submit.prevent="reserve_action" :data-action="modals.reserveModal.action">
				<div class="modal-header">
					<h5 class="modal-title" v-if="modals.reserveModal.action == `create`">Установить резерв</h5>
					<h5 class="modal-title" v-if="modals.reserveModal.action == `delete`">Удалить резерв</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<ul>
						<li>
							<label>
								<input type="checkbox" @change="reserveModalAll" v-model="modals.reserveModal.all">Все
							</label>
						</li>
					{% for item in orgs %}
						{% if item.stock|length > 0 %}
							<li>
								<label>
									<input type="checkbox" name="data[org][]" value="{{item.id}}" class="reserveModalOrgCheckbox">
									{{item.organization.name}}
								</label>
								<ul>
									{% for item_stock in item.stock %}
										<li>
											<label>
												<input type="radio" name="data[stock][{{item_stock.org}}]" value="{{item_stock.id}}"
												{% if item_stock.id == item.stock_id_default %}checked{% endif %}
												>
												{{item_stock.name}}
											</label>
										</li>
									{% endfor %}
								</ul>
							</li>
						{% endif %}
					{% endfor %}
					</ul>
				</div>
				<div class="modal-footer">
					<button type="submit" class="btn btn-primary" v-if="modals.reserveModal.action == `create`">Установить</button>
					<button type="submit" class="btn btn-danger" v-if="modals.reserveModal.action == `delete`">Удалить</button>
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
				</div>
			</form>
		</div>
	</div>
</div>
