{# comment modal #}
<div class="modal fade" id="commentModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<form @submit.prevent="addCommentModal" enctype="multipart/form-data">
				<div class="modal-header">
					<h5 class="modal-title">Комментарий</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body bg-light">
					<template v-if="modals.commentModal.load"><i class="fad fa-spinner fa-spin fa-2xl"></i></template>
					<template v-else>
						<div v-if="modals.commentModal.messages.length > 0" style="max-height: 400px;overflow-x: hidden;overflow-y: auto;" class="d-flex flex-column gap-3">
							<div v-for="message in modals.commentModal.messages" class="card">
								<div class="card-header">
									<div>Автор: <b>${message.user.short_user_name}</b></div>
									<div>Дата: <b>${message.date_view} </b></div>
  								</div>
								<div class="card-body">
									${message.text}
									<div v-if="message.attach">
										<a v-for="attach in message.attach" :href="`/download/${attach.id}`" target="_blank">${attach.name}</a>
									</div>
								</div>
							</div>
						</div>
						<div v-else>Комментарии отсутствуют!</div>
					</template>
					<hr class="m-3">
					<textarea class="form-control" placeholder="Введите комментарий..." v-model="modals.commentModal.message" name="text"></textarea>
					<input type="file" class="form-control mt-3" name="file">
				</div>
				<div class="modal-footer">
					<button type="submit" class="btn btn-primary" v-if="!modals.commentModal.load_button">Добавить комментарий</button>
					<button type="button" class="btn btn-primary" v-else disabled><i class="fad fa-spinner fa-spin fa-2xl"></i></button>
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
				</div>
			</form>
		</div>
	</div>
</div>
{# message modal #}
<div class="modal fade" id="messageModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Отправить сообщение</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<template v-if="modals.messageModal.load"><i class="fad fa-spinner fa-spin fa-2xl"></i></template>
				<template v-else>
					<div v-if="modals.messageModal.data.length > 0" style="max-height: 400px;overflow-x: hidden;overflow-y: auto;">
						<template v-if="modals.messageModal.step == 1">
							<div v-for="item in modals.messageModal.data"
							@click="setMessengers(item)" class="cp">
								${item.users_org.user.short_user_name}
							</div>
						</template>
						<template v-if="modals.messageModal.step == 2">
							<div v-for="item in modals.messageModal.data_select.messengers">
								<label>
									<input type="checkbox" :disabled="!item.status" v-model="item.value">
									${item.name}
								</label>
							</div>
						</template>
					</div>
					<div v-else>Пользователи отсутствуют!</div>
				</template>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-primary" v-if="modals.messageModal.step == 2" @click="sendMessage" data-bs-dismiss="modal">Отправить</button>
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
			</div>
		</div>
	</div>
</div>
{# users modal #}
<div class="modal fade" id="usersModal" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Список пользователей</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<form @submit.prevent="addUser" class="d-flex">
					{{select_users_all.select|raw}}
					<button class="btn btn-sm btn-success">Добавить</button>
				</form>
				<table class="table" v-if="modals.usersModal.data.length > 0">
					<thead>
						<tr>
							<th>Пользователь</th>
							<th>Тип</th>
							<th>Действия</th>
						</tr>
					</thead>
					<tbody>
						<tr v-for="(item, index) in modals.usersModal.data">
							<td>${item.user.full_user_name}</td>
							<td>${item.type_view}</td>
							<td>
								<div class="btn-group">
									<button type="button" class="btn btn-sm btn-danger" @click="deleteUser(index)">Удалить</button>
								</div>
							</td>
						</tr>
					</tbody>
				</table>
				<div v-else class="mt-3">Пользователи отсутствуют!</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
			</div>
		</div>
	</div>
</div>
{# assembly modal #}
<div class="modal fade" id="assemblyModal" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<form @submit.prevent="assemblyCreate">
				<div class="modal-header">
					<h5 class="modal-title">Отправить на сборку</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
						Вы действительно хотите отправить на сборку:
						<h4 class="mt-3">Внимание! Если количество 0, на сборку товар отправлен не будет!</h4>
						<div>
							<div v-if="modals.assemblyModal.data.length > 0">
								<div v-for="item in modals.assemblyModal.data" class="mt-3">
									<div>${item.sales_detail.s_name}</div>
									<div>
										<input
											type="number"
											class="form-control"
											:value="item.count"
											:name="`count[${item.sales_detail.id}]`"
											min="0"
											:max="item.count"
											step="any"
											required
										>
									</div>
								</div>
							</div>
							<div v-else>Загрузка...</div>
						</div>
				</div>
				<div class="modal-footer">
					<button class="btn btn-primary" data-bs-dismiss="modal">Отправить</button>
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
				</div>
			</form>
		</div>
	</div>
</div>
