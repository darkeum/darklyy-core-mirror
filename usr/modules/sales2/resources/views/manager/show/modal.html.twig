{# status modal #}
<div class="modal fade" id="statusModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Лог статуса товара</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<div v-html="modals.statusModal.data"></div>
				<div v-if="modals.statusModal.load">Загрузка данных...</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
			</div>
		</div>
	</div>
</div>
{# Place order #}
<div class="modal fade" id="placeOrderModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
		<form ref="placeOrderForm">
    	  <div class="modal-header">
    	    <h5 class="modal-title">Какими образом вы хотите разместить заказ?</h5>
    	    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    	  </div>
    	  <div class="modal-body">
		  	<template v-if="!modals.placeOrderModal.flag">
    	    	<table class="table list-table" style="padding: 0px;">
					<tbody>
					  	<tr @click="
						  modals.placeOrderModal.flag = true;
						  modals.placeOrderModal.list[0] = true;
						"><td class="cp"><i class="icon text-alert fas fa-first-aid me-2"></i>Отправить на актуализацию сроков и цен</td></tr>
					  	<tr @click="
						  modals.placeOrderModal.flag = true;
						  modals.placeOrderModal.list[1] = true;
						"><td class="cp"><i class="icon text-alert fas fa-first-aid me-2"></i>Отправить на актуализацию сроков и цен (с уведомлением)</td></tr>
					  	<tr @click="
						  modals.placeOrderModal.flag = true;
						  modals.placeOrderModal.list[2] = true;
						"><td class="cp"><i class="icon text-info fa fa-shopping-cart me-2"></i>Отправить на закупку снабженцам</td></tr>
					  	<tr @click="
						  modals.placeOrderModal.flag = true;
						  modals.placeOrderModal.list[3] = true;
						"><td class="cp"><i class="icon text-info fa fa-shopping-cart me-2"></i>Отправить на закупку самому себе</td></tr>
					</tbody>
				</table>
			</template>
			<template v-else>
				<div v-if="modals.placeOrderModal.list[0]">
					Вы действительно хотите отправить заказ №${sales.numb} на актуализацию сроков и цен без уведомления снабженцам?
				</div>
				<div v-if="modals.placeOrderModal.list[1]">
					Вы действительно хотите отправить заказ №${sales.numb} на актуализацию сроков и цен с уведомлением снабженцам?
				</div>
				<div v-if="modals.placeOrderModal.list[2]">
					Вы действительно хотите отправить заказ №${sales.numb} в отдел снабжения на закупку?
					<select class="form-select" name="org">
						{% for org in orgs %}
							<option value="{{org.id}}" {% if org.id == sales.org %}selected{% endif %}
							>{{org.organization.name}}</option>
						{% endfor %}
					</select>
				</div>
				<div v-if="modals.placeOrderModal.list[3]">
					Вы действительно хотите отправить заказ №${sales.numb} в отдел снабжения на закупку?
					<select class="form-select" name="org">
						{% for org in orgs %}
							<option value="{{org.id}}" {% if org.id == sales.org %}selected{% endif %}
							>{{org.organization.name}}</option>
						{% endfor %}
					</select>
				</div>
			</template>
    	  </div>
    	  <div class="modal-footer">
		  	<button type="button" class="btn btn-primary" data-bs-dismiss="modal" v-if="modals.placeOrderModal.list[0]" @click="send_sos()">Отправить</button>
		  	<button type="button" class="btn btn-primary" data-bs-dismiss="modal" v-if="modals.placeOrderModal.list[1]" @click="send_sos(true)">Отправить</button>
		  	<button type="button" class="btn btn-primary" data-bs-dismiss="modal" v-if="modals.placeOrderModal.list[2]" @click="send_purchase();">Отправить</button>
		  	<button type="button" class="btn btn-primary" data-bs-dismiss="modal" v-if="modals.placeOrderModal.list[3]" @click="send_purchase(0);">Отправить</button>
    	    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
    	  </div>
		</form>
    </div>
  </div>
</div>
