{% extends "_layout/base-layout.html.twig" %}

{% block  title %}Список заказов{% endblock title %}
{% block  header_title %}{% endblock header_title %}

{% block  header_nav %}
    {{ include('@sales2/manager/nav_list.html.twig') }}
{% endblock header_nav %}

{% block scripts %}
    <script src="/usr/modules/sales/admin/assets/js/FastTask.js"></script>
    <script src="/usr/modules/sales/admin/assets/js/FastTask5.js"></script>
	{{ assets({files: [
        "@sales2_/resources/js/main.js",
    ], name: 'script.js'}) }}
{% endblock %}

{% block links %}
	{{ assets({files: []}) }}
{% endblock %}

{% block  content %}
   {{ grid|raw }}

   <div class="modal fade" id="viewTaskModal" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
		<div class="modal-dialog" role="document">
		  <div class="modal-content admin-form">
			<div class="modal-header">
			  <h5 class="modal-title" id="viewTaskModalHeader"></h5>
			</div>
			<div class="modal-body" id="viewTaskModalBody"></div>
			<div class="modal-footer">
			  	<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
			</div>
		  </div>
		</div>
  	</div>
{% endblock content %}