{% extends "_layout/base-layout.html.twig" %}

{% block  header_title %}{% endblock header_title %}

{% block  header_nav %}
	{{ include('@profile/roles/nav_list') }}
{% endblock header_nav %}

{% block scripts %}
	{{ assets({files: [], name: 'script.js'}) }}
{% endblock %}

{% block links %}
	{{ assets({files: []}) }}
{% endblock %}

{% block  content %}
	<div id="content">
        {% if session('status') %}
            <div class="alert alert-success">
                {{ session('status') }}
            </div>
        {% endif %}
		<div class="card">
			<div class="card-body">
				<form id="tab-main-form" action="{% if id %}{{route('admin.profile.permission.update', id)}}{% else %}{{route('admin.profile.permission.store')}}{% endif %}" method="POST">
                    {% if id %}<input type="hidden" name="_method" value="PUT">{% endif %}
					<div class="mb-3 btn-group">
						<button type="submit" class="btn btn-success">Записать</button>
					</div>
					<div class="mb-3 row">
						<label class="col-2 col-form-label text-end">Наименование</label>
						<div class="col-8"><input type="text" class="form-control" value="{{permission.name}}" name="name" required></div>
					</div>
                    {% include '@profile/roles/guard_name' with {'guard_name': permission.guard_name} only %}
				</form>
			</div>
		</div>
	</div>
{% endblock content %}
