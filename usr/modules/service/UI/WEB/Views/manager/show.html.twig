{% extends "_layout/base-layout.html.twig" %}

{% block  header_title %} {{ __('order') }} {% endblock header_title %}

{% block  header_nav %}
    <ul class="nav nav-list nav-list-topbar"> 
        <li class=""><a href="{{ router('admin.portfolio.index') }}">{{ __('order.list') }} </a> </li> 
    </ul>
{% endblock header_nav %}

{% block  content %}  
<div id="content" class="">
	<div class="row">
		<div class="col-md-12">
			<div class="card">
				<div class="card-body">
					<div class="row">
						<div class="col-md-6 border-bottom">
    						<h2 class="pb-2">Заявка #{{ order.id }}</h2>
						</div>	
						<div class="col-md-6 text-end border-bottom">
							<div class="btn-group" role="group">
						  		<button id="btnGroupDrop1" type="button" class="btn btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">Dropdown</button>
						  		<ul class="dropdown-menu" aria-labelledby="btnGroupDrop1">
									<li><a class="dropdown-item" href="#">Dropdown link</a></li>
									<li><a class="dropdown-item" href="#">Dropdown link</a></li>
						  		</ul>
							</div>
					  	</div>		
					</div>					
					<div class="row g-4 py-5 row-cols-1 row-cols-lg-4">
						<div class="col d-flex align-items-start">
					  		<div class="icon-square bg-light text-dark flex-shrink-0 me-3">
								<i class="far fa-user fa-lg"></i>
					  		</div>
					 		<div>
					  			<h4 class="fw-bold mb-0">{{ order.surname }} {{ order.name }} {{ order.ochestvo }}</h4>
								<p>ФИО заявителя</p>
							</div>
						</div>
						<div class="col d-flex align-items-start">
					  		<div class="icon-square bg-light text-dark flex-shrink-0 me-3">
								<i class="far fa-user fa-lg"></i>
					  		</div>
					 		<div>
					  			<h4 class="fw-bold mb-0">{{ order.email }}</h4>
								<p>E-mail заявителя</p>
							</div>
						</div>
						<div class="col d-flex align-items-start">
					  		<div class="icon-square bg-light text-dark flex-shrink-0 me-3">
								<i class="far fa-user fa-lg"></i>
					  		</div>
					 		<div>
					  			<h4 class="fw-bold mb-0">{{ order.phone }}</h4>
								<p>Телефон заявителя</p>
							</div>
						</div>
						<div class="col d-flex align-items-start">
					  		<div class="icon-square bg-light text-dark flex-shrink-0 me-3">
								<i class="far fa-user fa-lg"></i>
					  		</div>
					 		<div>
					  			<h4 class="fw-bold mb-0">{{ order.type }}</h4>
								<p>Тип заявителя</p>
							</div>
						</div>
						<div class="col d-flex align-items-start">
					  		<div class="icon-square bg-light text-dark flex-shrink-0 me-3">
								<i class="far fa-user fa-lg"></i>
					  		</div>
					 		<div>
					  			<h4 class="fw-bold mb-0">{{ order.message }}</h4>
								<p>Сообщение</p>
							</div>
						</div>
					</div>
  				</div>
			</div>
		</div>
	</div>
</div>
{% endblock content %}