{% extends "_layout/base-layout.html.twig" %}

{% block  header_title %}
	{% if id is defined %}
		Организация
		{{organization.name}}
	{% else %}
		Создание организации
	{% endif %}
{% endblock header_title %}

{% block  header_nav %}
	{{ include('@organizations/manager/nav_list.html.twig') }}
{% endblock header_nav %}

{% block scripts %}
	<script type="text/javascript" src="https://cdn.jsdelivr.net/jquery.suggestions/17.2/js/jquery.suggestions.min.js"></script>
	<script>{{organization_select_user.js|raw}}</script>
	{{ assets({files: ['@organizations_/resources/js/edit.js']}) }}
{% endblock %}

{% block links %}
	<link href="https://cdn.jsdelivr.net/jquery.suggestions/17.2/css/suggestions.css" type="text/css" rel="stylesheet" />
	{{ assets({files: ['@organizations_/resources/css/edit.css']}) }}
{% endblock %}

{% block  content %}
	<input type="hidden" id="mainId" value="{{id}}">
	<input type="hidden" id="router_show" value="{{route('admin.organizations.show', '@id')}}">
	{% if id is defined %}
		<input type="hidden" id="router_update" value="{{route('admin.organizations.update', '@id')}}">
	{% endif %}
	<div id="content">
		<div class="card">
			{% if id is defined %}
				<div class="card-header">{% include "@organizations/manager/components/button-back.html.twig" %}</div>
			{% endif %}
			<div class="card-body">
				<nav>
					<div class="nav nav-tabs" id="nav-tab" role="tablist">
						<button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-main" type="button" role="tab" aria-selected="true">Основное</button>
						{% if id is defined %}
							<button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-contracts" type="button" role="tab" aria-selected="false">Договоры</button>
							<button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-bank-accounts" type="button" role="tab" aria-selected="false">Банковские счета</button>
							<button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-contact-faces" type="button" role="tab" aria-selected="false">Контактные лица</button>
						{% endif %}
					</div>
				</nav>
				<div class="tab-content" id="nav-tabContent">

					<div class="tab-pane fade show active p-3" id="tab-main" role="tabpanel">
						<form id="tab-main-form" action="{% if id is defined %}{{route('admin.organizations.update', id)}}{% else %}{{route('admin.organizations.store')}}{% endif %}" method="POST">
							<div class="mb-3 btn-group">
								<button type="submit" class="btn btn-success">Записать</button>
							</div>
							<input type="hidden" id="router_findByInn" value="{{route('admin.organizations.findByInn', '@id')}}">
							{% set link = '@organizations/manager/edit/edit-item.html.twig' %}
							{% embed link %}
								{% block title %}ИНН
								{% endblock %}
								{% block body %}
									<div class="input-group">
										<input type="text" class="form-control" value="{{organization.inn}}" name="inn" id="inn">
										<button class="btn btn-outline-secondary" type="button" id="fill-btn">Заполнить</button>
									</div>
								{% endblock %}
							{% endembed %}
							<hr>
							{% embed link %}
								{% block title %}Наименование
								{% endblock %}
								{% block body %}<input type="text" class="form-control" value="{{organization.name}}" name="name" id="name" required>
								{% endblock %}
							{% endembed %}
							{% embed link %}
								{% block title %}Полное наименование
								{% endblock %}
								{% block body %}<input type="text" class="form-control" value="{{organization.name_full}}" name="name_full" id="name_full" required>
								{% endblock %}
							{% endembed %}
							{% embed link %}
								{% block title %}Юридический адрес
								{% endblock %}
								{% block body %}<input type="text" class="form-control" value="{{organization.yaddress}}" name="yaddress" id="yaddress" required>
								{% endblock %}
							{% endembed %}
							{% embed link %}
								{% block title %}Почтовый адрес
								{% endblock %}
								{% block body %}<input type="text" class="form-control" value="{{organization.maddress}}" name="maddress" id="maddress" required>
								{% endblock %}
							{% endembed %}
							{% if organization.type != "INDIVIDUAL" %}
								{% embed link %}
									{% block title %}КПП
									{% endblock %}
									{% block body %}<input type="text" class="form-control" value="{{organization.kpp}}" name="kpp" id="kpp" required>
									{% endblock %}
								{% endembed %}
							{% endif %}
							{% embed link %}
								{% block title %}ОГРН
								{% endblock %}
								{% block body %}<input type="text" class="form-control" value="{{organization.ogrn}}" name="ogrn" id="ogrn" required>
								{% endblock %}
							{% endembed %}
							{% embed link %}
								{% block title %}Должность руководителя
								{% endblock %}
								{% block body %}<input type="text" class="form-control" value="{{organization.post}}" name="post" id="post" required>
								{% endblock %}
							{% endembed %}
							{% embed link %}
								{% block title %}Руководитель
								{% endblock %}
								{% block body %}<input type="text" class="form-control" value="{{organization.director}}" name="director" id="director" required>
								{% endblock %}
							{% endembed %}
							{% embed link %}
								{% block title %}Действует на основании
								{% endblock %}
								{% block body %}<input type="text" class="form-control" value="{{organization.dey}}" name="dey" id="dey" required>
								{% endblock %}
							{% endembed %}
							{% embed link %}
								{% block title %}Вид контрагента
								{% endblock %}
								{% block body %}
									<select name="type" id="type" class="form-control">
										{% for item in organization_type %}
											<option value="{{item.key}}" {% if organization.type == item.key %} selected {% endif %}>{{item.value}}</option>
										{% endfor %}
									</select>
								{% endblock %}
							{% endembed %}
							<hr>
							{% embed link %}
								{% block title %}Ответственный по умолчанию
								{% endblock %}
								{% block body %}
									<div class="row">{{organization_select_user.select|raw}}</div>
								{% endblock %}
							{% endembed %}
							{% embed link %}
								{% block title %}Тип контрагента
								{% endblock %}
								{% block body %}
									<select name="client_type" id="client_type" class="form-control">
										{% for key,value in organization_client_type %}
											<option value="{{key}}" {% if organization.client_type == key %} selected {% endif %}>{{value}}</option>
										{% endfor %}
									</select>
								{% endblock %}
							{% endembed %}
							{% embed link %}
								{% block title %}Телефон
								{% endblock %}
								{% block body %}<input type="text" class="form-control" value="{{organization.phone}}" name="phone" id="phone">
								{% endblock %}
							{% endembed %}
							{% embed link %}
								{% block title %}E-mail
								{% endblock %}
								{% block body %}<input type="email" class="form-control" value="{{organization.email}}" name="email" id="email">
								{% endblock %}
							{% endembed %}
						</form>
					</div>

					{% if id is defined %}
						<input type="hidden" id="router_edit-contracts-list" value="{{route('admin.organizations.editContractsList', id)}}">
						<div class="tab-pane fade p-3" id="tab-contracts" role="tabpanel">
							<div class="btn-group mb-3">
								<button type="button" class="btn btn-outline-secondary" id="reset_contract_default">Сбросить договор по умолчанию</button>
							</div>
							<table class="table table-striped">
								<thead>
									<tr>
										<th title="Договор по умолчанию">
											<i class="fas fa-check text-success"></i>
										</th>
										<th>Уникальный идентификатор</th>
										<th>Номер</th>
										<th>Особый номер</th>
										<th>Тип договора</th>
										<th>Вид договора</th>
										<th>Дата</th>
										<th>Действия</th>
									</tr>
								</thead>
								<tbody id="bodyContractsList">{% include '@organizations/manager/edit/edit-contracts-list.html.twig' %}</tbody>
							</table>
						</div>

						<div class="tab-pane fade p-3" id="tab-bank-accounts" role="tabpanel">
							<div class="btn-group mb-3">
								<button type="button" class="btn btn-success" id="bankAccountsCreateBtn">Создать</button>
							</div>
							<div class="mb-3">
								<table class="table table-striped">
									<thead>
										<tr>
											<th>По умолчанию</th>
											<th>Уникальный идентификатор</th>
											<th>Наименование</th>
											<th>Адрес банка</th>
											<th>БИК банка</th>
											<th>Корреспондентский счет</th>
											<th>Расчетный счет</th>
											<th>Действия</th>
										</tr>
									</thead>
									<tbody id="bodyBankAccountsList">{% include '@organizations/manager/edit/edit-bank-accounts-list.html.twig' %}</tbody>
								</table>
							</div>

							<input type="hidden" id="router_organizations_bank_list" value="{{route('admin.organizations_bank.show', id)}}">
							<input type="hidden" id="router_organizations_bank_create" value="{{route('admin.organizations_bank.store')}}">
							<input type="hidden" id="router_organizations_bank_update" value="{{route('admin.organizations_bank.update', '@id')}}">
							<input type="hidden" id="router_organizations_bank_delete" value="{{route('admin.organizations_bank.destroy', '@id')}}">
							<div class="modal fade" id="bankAccountsCreateModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
								<div class="modal-dialog">
									<div class="modal-content">
										<form id="bankAccountsCreateModalForm">
											<input type="hidden" name="oid" value="{{id}}">
											<div class="modal-header">
												<h5 class="modal-title" id="exampleModalLabel">Банковские данные</h5>
												<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
											</div>
											<div class="modal-body">
												<div class="row mb-3">
													<div class="col-3 col-form-label text-end">Поиск</div>
													<div class="col-9"><input id="ba_search" type="text" placeholder="Введите название, БИК или SWIFT" class="form-control" autocomplete="off"></div>
												</div>
												<hr>
												<div class="row mb-3">
													<div class="col-3 col-form-label text-end">Краткое наименование</div>
													<div class="col-9">
														<input id="ba_name_short" name="name_short" type="text" placeholder="Введите краткое наименование банка" class="form-control" autocomplete="off" required>
													</div>
												</div>
												<div class="row mb-3">
													<div class="col-3 col-form-label text-end">Наименование</div>
													<div class="col-9">
														<input id="ba_name" name="name" type="text" placeholder="Введите наименование банка" class="form-control" autocomplete="off" required>
													</div>
												</div>
												<div class="row mb-3">
													<div class="col-3 col-form-label text-end">Адрес банка</div>
													<div class="col-9">
														<input id="ba_address" name="address" type="text" placeholder="Введите адрес банка" class="form-control" autocomplete="off" required>
													</div>
												</div>
												<div class="row mb-3">
													<div class="col-3 col-form-label text-end">БИК банка</div>
													<div class="col-9">
														<input id="ba_bik" name="bik" type="text" placeholder="Укажите БИК банка" class="form-control" autocomplete="off" required>
													</div>
												</div>
												<div class="row mb-3">
													<div class="col-3 col-form-label text-end">Корр. счет</div>
													<div class="col-9">
														<input id="ba_kschet" name="kschet" type="text" placeholder="Укажите корреспондентский счет" class="form-control" autocomplete="off" required>
													</div>
												</div>
												<div class="row mb-3">
													<div class="col-3 col-form-label text-end">Расчетный счет</div>
													<div class="col-9">
														<input id="ba_rschet" name="rschet" type="text" placeholder="Укажите расчетный счет" class="form-control" autocomplete="off" required>
													</div>
												</div>
											</div>
											<div class="modal-footer">
												<button class="btn btn-success" id="bankAccountsCreateModalBtn"></button>
												<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
											</div>
										</form>
									</div>
								</div>
							</div>
						</div>

						<div class="tab-pane fade p-3" id="tab-contact-faces" role="tabpanel">
							<div class="btn-group mb-3">
								<button type="button" class="btn btn-success" id="contactFacesButtonCreate">Создать</button>
							</div>
							<div class="mb-3">
								<table class="table table-striped">
									<thead>
										<tr>
											<th>ФИО</th>
											<th>E-mail</th>
											<th>Телефон</th>
											<th>Дополнительный телефон</th>
											<th>Назначение</th>
											<th>Должность</th>
											<th>Комментарий</th>
											<th>Действия</th>
										</tr>
									</thead>
									<tbody id="bodyContactFacesList">{% include '@organizations/manager/edit/edit-contact-faces-list.html.twig' %}</tbody>
								</table>
							</div>

							<input type="hidden" id="router_contact_faces_list" value="{{route('admin.organizations_contact_faces.show', id)}}">
							<input type="hidden" id="router_contact_faces_create" value="{{route('admin.organizations_contact_faces.store')}}">
							<input type="hidden" id="router_contact_faces_update" value="{{route('admin.organizations_contact_faces.update', '@id')}}">
							<input type="hidden" id="router_contact_faces_delete" value="{{route('admin.organizations_contact_faces.destroy', '@id')}}">

							<div class="modal fade" id="contactFacesModal" aria-labelledby="exampleModalLabel" aria-hidden="true">
							  <div class="modal-dialog">
							    <div class="modal-content">
									<form id="contactFacesModalForm">
										<input type="hidden" name="oid" value="{{id}}">
							      		<div class="modal-header">
							      		  <h5 class="modal-title" id="exampleModalLabel">Контактное лицо</h5>
							      		  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
							      		</div>
							      		<div class="modal-body">
											<div class="row mb-3">
												<div class="col-3 col-form-label text-end">Пользователь</div>
												<div class="col-9">
													<script type="application/json" id="users-source">{{users|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw}}</script>
													<select name="uid" id="cf_uid" class="form-control">
														{% for user in [{id: "", surname: "Не выбрано"}]|merge(users) %}
															<option value="{{user.id}}">
																{{user.surname}} {{user.name}} {{user.ochestvo}}
															</option>
														{% endfor %}
													</select>
													<div id="cf_uid_div"></div>
												</div>
											</div>
											<hr>
											<div class="row mb-3">
												<div class="col-3 col-form-label text-end">Фамилия</div>
												<div class="col-9">
													<input id="cf_surname" name="surname" type="text" placeholder="Введите фамилию" class="form-control" autocomplete="off" required>
												</div>
											</div>
											<div class="row mb-3">
												<div class="col-3 col-form-label text-end">Имя</div>
												<div class="col-9">
													<input id="cf_name" name="name" type="text" placeholder="Введите имя" class="form-control" autocomplete="off" required>
												</div>
											</div>
											<div class="row mb-3">
												<div class="col-3 col-form-label text-end">Отчество</div>
												<div class="col-9">
													<input id="cf_ochestvo" name="ochestvo" type="text" placeholder="Введите отчество" class="form-control" autocomplete="off" required>
												</div>
											</div>
											<div class="row mb-3">
												<div class="col-3 col-form-label text-end">E-mail</div>
												<div class="col-9">
													<input id="cf_email" name="email" type="email" placeholder="Введите e-mail" class="form-control" autocomplete="off" required>
												</div>
											</div>
											<div class="row mb-3">
												<div class="col-3 col-form-label text-end">Телефон</div>
												<div class="col-9">
													<input id="cf_phone" name="phone" type="tel" placeholder="Введите телефон" class="form-control" autocomplete="off" required>
												</div>
											</div>
											<div class="row mb-3">
												<div class="col-3 col-form-label text-end">Доп телефон</div>
												<div class="col-9">
													<input id="cf_phone2" name="phone2" type="tel" placeholder="Введите доп телефон, если есть" class="form-control" autocomplete="off">
												</div>
											</div>
											<div class="row mb-3">
												<div class="col-3 col-form-label text-end">Назначение</div>
												<div class="col-9">
													<select name="type" id="cf_type" class="form-control">
														{% for key,value in users_org_type %}
															<option value="{{key}}">{{value}}</option>
														{% endfor %}
													</select>
												</div>
											</div>
											<div class="row mb-3">
												<div class="col-3 col-form-label text-end">Должность</div>
												<div class="col-9">
													<input id="cf_post" name="post" type="text" placeholder="Введите должность" class="form-control" autocomplete="off" required>
												</div>
											</div>
											<div class="row mb-3">
												<div class="col-3 col-form-label text-end">Комментарий</div>
												<div class="col-9">
													<textarea name="comment" id="cf_comment" cols="30" rows="10" class="form-control" placeholder="Введите комментарий"></textarea>
												</div>
											</div>
							      		</div>
							      		<div class="modal-footer">
								  			<button class="btn btn-primary" id="contactFacesModalFormButton"></button>
							      		  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
							      		</div>
									</form>
							    </div>
							  </div>
							</div>

						</div>
					{% endif %}
				</div>
			</div>
		</div>
	</div>
{% endblock content %}