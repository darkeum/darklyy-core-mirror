<script type="application/json" id="contact-faces-source">{{organization.users|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw}}</script>
{% for userOrg in organization.users %}
    {% set user = userOrg.user %}
	<tr>
		<td>{{user.surname}}
			{{user.name}}
			{{user.ochestvo}}</td>
		<td>{{user.email}}</td>
		<td>{{user.phone}}</td>
		<td>{{user.phone2}}</td>
		<td>{{userOrg.type_view}}</td>
		<td>{{userOrg.post}}</td>
		<td>{{userOrg.comment}}</td>
		<td>
			<div class="btn-group">
				<button type="button" class="btn btn-sm btn-info contact-faces-button-edit" data-id="{{userOrg.id}}">Редактировать</button>
				<button type="button" class="btn btn-sm btn-danger contact-faces-button-delete" data-id="{{userOrg.id}}">Удалить</button>
			</div>
		</td>
	</tr>
{% endfor %}
