{% extends "_layout/base-layout.html.twig" %}

{% block  header_title %}Организация
	{{organization.name}}
{% endblock header_title %}

{% block  header_nav %}
	{{ include('@organizations/manager/nav_list.html.twig') }}
{% endblock header_nav %}

{% block scripts %}{% endblock %}

{% block links %}
{{ assets({files: [
        '@organizations_/resources/css/subpages.css',
    ], name: 'style.css'}) }}
{% endblock %}

{% block content %}
	<div id="content">
		<div class="card">
			<div class="card-header">{% include "@organizations/manager/components/button-back.html.twig" %}</div>
			<div class="card-body">
				<h2>
					{% block items_title %}{% endblock %}
				</h2>
				<p class="text-secondary">
					{% block items_description %}{% endblock %}
				</p>
				<div class="sub-items">
					{% block item_body %}{% endblock %}
				</div>
				<div class="mt-3">
					{% block item_pages %}{% endblock %}
				</div>
			</div>
		</div>
	</div>
{% endblock %}
