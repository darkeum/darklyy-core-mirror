{% extends "@organizations/manager/subpages.html.twig" %}

{% from '@organizations/manager/macro/priceView.html.twig' import priceView %}
{% from '@organizations/manager/macro/nf.html.twig' import nf %}

{% block items_title %}
	Связи
{% endblock %}
{% block items_description %}
	Сведения о связях с организациями и предпринимателями, полученные на основании анализа информации из ЕГРЮЛ и ЕГРИП
{% endblock %}
{% block item_body %}
	<style>
		.status_view{
    		box-sizing: border-box;
    		border: 0 solid #e9eef1;
    		border-color: rgba(44,184,137);
    		border-radius: 1rem;
    		border-width: 1px;
    		font-size: .875rem;
    		line-height: 1.25rem;
    		padding-left: .75rem;
    		padding-right: .75rem;
    		padding-top: .125rem;
    		padding-bottom: .125rem;
    		color: rgba(44,184,137);
    		text-transform: uppercase;
		}
	</style>
	<nav>
		<div class="nav nav-tabs" id="nav-tab" role="tablist">
			<button class="nav-link active" data-bs-toggle="tab" data-bs-target="#nav-relation-all" type="button" role="tab" aria-selected="true">Все связи</button>
            {% for st in stat_type %}
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#nav-type-{{st.id}}" type="button" role="tab" aria-selected="false">{{st.name}}</button>
            {% endfor %}
		</div>
	</nav>
	<div class="tab-content" id="nav-tabContent">
		<div class="tab-pane fade show active" id="nav-relation-all" role="tabpanel">
            {% for item in relations.content %}
                {% include "@organizations/manager/relations/relations-item.html.twig" with {item, stat_type, status} only %}
            {% endfor %}
        </div>
        {% for st in stat_type %}
			<div class="tab-pane fade" id="nav-type-{{st.id}}" role="tabpanel">
				{% set flag = true %}
				{% for rc in relations.content %}
					{% for rcr in rc.relations %}
						{% if rcr.relationCategory == st.id %}
							{% set flag = false %}
							{% include "@organizations/manager/relations/relations-item.html.twig" with {item:rc, stat_type, status, category_type:st.id} only %}
						{% endif %}
					{% endfor %}
				{% endfor %}
				{% if flag %}
					Связи не найдены
				{% endif %}
			</div>
        {% endfor %}
	</div>
{% endblock %}
{% block item_pages %}
	{# {% include "@organizations/manager/components/pagination.html.twig" with {data: arbitrages} only %} #}
{% endblock %}
