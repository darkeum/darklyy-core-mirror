{% extends "@organizations/manager/subpages.html.twig" %}

{% from '@organizations/manager/macro/priceView.html.twig' import priceView %}
{% from '@organizations/manager/macro/nf.html.twig' import nf %}

{% block items_title %}
	Исполнительные производства
{% endblock %}
{% block items_description %}
	Сведения об исполнительных производствах в отношении {{organization.name}} на основании данных ФССП: {{analysis.fsspCount}} открытое производство
{% endblock %}
{% block item_body %}
	{% for item in fssp.content %}
		<div class="card">
			<div class="card-body">
				<div class="d-flex justify-content-between">
					<div>
						<div class="d-flex">
							<strong>{{item.executionDocType}}</strong>
							<div class="text-secondary ms-3">от {{item.executionDocDate|date("d.m.Y")}}</div>
						</div>
						<div>№{{item.processingNumber}} от {{item.processingDate|date("d.m.Y")}}</div>
						<div class="mt-3"><span class="text-secondary">Должник (Наименование, Юр. адрес):</span> {{item.companyName}} {{item.companyAddress}}</div>
						<div class="mt-3"><span class="text-secondary">Отдел судебных приставов:</span> {{item.departmentName}} {{item.departmentAddress}}</div>
					</div>
					<div class="d-flex flex-column justify-content-between">
						<div class="badge bg-warning text-dark">{{item.executionObject}}</div>
						<div class="border p-3 mt-3 d-flex flex-column justify-content-center align-items-center" style="width: 100px; height:100px">
							<div>Сумма</div>
							<strong>{{item.totalDebt}} ₽</strong>
						</div>
					</div>
				</div>
			</div>
		</div>
	{% endfor %}
{% endblock %}
{% block item_pages %}
	{% include "@organizations/manager/components/pagination.html.twig" with {data: fssp} only %}
{% endblock %}