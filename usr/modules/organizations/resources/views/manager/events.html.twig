{% extends "@organizations/manager/subpages.html.twig" %}

{% from '@organizations/manager/macro/priceView.html.twig' import priceView %}
{% from '@organizations/manager/macro/nf.html.twig' import nf %}

{% block items_title %}
События
{% endblock %}
{% block items_description %}
Информация о значимых событиях в истории организации на основе анализа доступных по различным источникам данных сведений
{% endblock %}
{% block item_body %}
	{% for event in events.content %}
		<div class="card">
			<div class="card-body">
				<div class="d-flex justify-content-between text-muted fw-bold">
					<div>{{event.date|date("d.m.Y")}}</div>
					<div>
						{% for et in events_type %}
							{% if et.id == event.categoryId %}
								{{et.name}}
							{% endif %}
						{% endfor %}
					</div>
				</div>
				<div>
					<h4>{{event.title}}</h4>
					{% if event.payload.price is not empty %}
						<strong>{{nf(event.payload.price, 2)}}
							₽</strong>
					{% endif %}
					{% if event.payload.purchaseNumber is not empty %}
						<div>№{{event.payload.purchaseNumber}}</div>
					{% endif %}
				</div>
				<div class="mt-3">{{event.text}}</div>
			</div>
		</div>
	{% endfor %}
{% endblock %}

{% block item_pages %}
	{% include "@organizations/manager/components/pagination.html.twig" with {data: events} only %}
{% endblock %}
