{% extends "@organizations/manager/subpages.html.twig" %}

{% from '@organizations/manager/macro/priceView.html.twig' import priceView %}
{% from '@organizations/manager/macro/nf.html.twig' import nf %}

{% block items_title %}
	Арбитражные дела
{% endblock %}
{% block items_description %}
	Сведения об участии в судебных процессах:
	<strong>{{arbitrages_count.openCases}}</strong>
	открытых и
	<strong>{{arbitrages_count.closedCases}}</strong>
	закрытых
{% endblock %}
{% block item_body %}
	<style>
		.arbitrage-lines {
			display: grid;
			grid-row-gap: 10px;
		}
		.arbitrage-line {
			display: flex;
			gap: 5px;
		}
	</style>
	{% for arbitrage in arbitrages.content %}
		<div class="card">
			<div class="card-body">
				<div class="d-flex justify-content-between">
					<div>
						<strong>№
							{{arbitrage.caseNumber}}</strong>
						<span class="text-muted">от
							{{event.date|date("d.m.Y")}}</span>
					</div>
					<div class="badge {% if arbitrage.closed %}bg-secondary{% else %}bg-warning text-dark{% endif %}">
						{% if arbitrage.closed %}Закрыто{% else %}Открыто
						{% endif %}
					</div>
				</div>
				<div class="arbitrage-lines mt-3">
					{% if arbitrage.caseCategory is not empty %}
						<strong>{{arbitrage.caseCategory}}</strong>
					{% endif %}
					<div class="arbitrage-line">
						<span class="text-muted">Сумма:</span>
						{{priceView(arbitrage.caseSum)}}
						₽</div>
					{% if arbitrage.closed %}
						<div class="arbitrage-line">
							<span class="text-muted">Дата завершения:</span>
							{{arbitrage.closeDate|date("d.m.Y")}}</div>
					{% endif %}
					{% set prev = false %}
					{% for participantsList in arbitrage.participantsList %}
						<div class="arbitrage-line">
                            {% if prev != participantsList.sideType %}
                                <span class="text-muted">{{participantsList.sideType}}:</span>
                            {% endif %}
							
							{{participantsList.participantName}}
						</div>
                        {% set prev = participantsList.sideType %}
					{% endfor %}
					<a href="{{arbitrage.webLink}}" target="_blank">
						<i class="fas fa-external-link-alt"></i>Посмотреть на сайте КАД</a>
				</div>
			</div>
		</div>
	{% endfor %}
{% endblock %}
{% block item_pages %}
	{% include "@organizations/manager/components/pagination.html.twig" with {data: arbitrages} only %}
{% endblock %}