{% from '@organizations/manager/macro/priceView.html.twig' import priceView %}
<div class="organization-panel">
    <div class="statistic-name">{{rus_name}}, &#8381;</div>
    {% if total is not empty %}
        <div class="organization-finreport__value">
            <div class="price-container">{{priceView(total)}}</div>
            {% if year is defined %}<div class="organization-finreport__year text-grey">({{year}}&nbsp;г.)</div>{% endif %}
        </div>
        <div class="organization-finreport__value">
            {% if diff is defined and diff is not null %}
            <div class="d-flex {% if diff > 0 %}text-green{% else %}text-red{% endif %}">{% if diff > 0 %}+{% endif %}{{priceView(diff)}}</div>
            {% endif %}
            {% if proc is defined and proc is not null %}
                <div class="organization-finreport__proc text-grey">({{proc|round(2)}}%)</div>
            {% endif %}
        </div>
    {% else %}
        <div class="text-grey">Информация отсутствует</div>
    {% endif %}
</div>