{% extends "@organizations/manager/subpages.html.twig" %}

{% from '@organizations/manager/macro/priceView.html.twig' import priceView %}
{% from '@organizations/manager/macro/nf.html.twig' import nf %}

{% block items_title %}
	Госконтракты
{% endblock %}

{% set supplier_count = contracts_total.supplier.RUB.count ?? 0 %}
{% set customer_count = contracts_total.customer.RUB.count ?? 0 %}

{% block items_description %}
	Организация {{organization.name}} являлась поставщиком в <strong>35</strong> госконтрактах на сумму <strong>49,16 млн ₽</strong>
{% endblock %}
{% block item_body %}
	<style>
		.contracts-items{
			display: grid;
			grid-row-gap: 20px;
		}
	</style>
	<nav>
		<div class="nav nav-tabs" id="nav-tab" role="tablist">
			<button class="nav-link active" data-bs-toggle="tab" data-bs-target="#nav-supplier" type="button" role="tab">Поставщик ({{supplier_count}})</button>
			<button class="nav-link" data-bs-toggle="tab" data-bs-target="#nav-customer" type="button" role="tab">Заказчик ({{customer_count}})</button>
		</div>
	</nav>
	<div class="tab-content" id="nav-tabContent">
		<div class="tab-pane fade show active" id="nav-supplier" role="tabpanel" aria-labelledby="nav-home-tab">
			<div class="contracts-items">{% include "@organizations/manager/contracts/contracts-items.html.twig" with {data: contracts_supplier} only %}</div>
			<div class="mt-3">{% include "@organizations/manager/components/pagination.html.twig" with {data: contracts_supplier} only %}</div>
        </div>
		<div class="tab-pane fade" id="nav-customer" role="tabpanel" aria-labelledby="nav-profile-tab">
			<div class="contracts-items">{% include "@organizations/manager/contracts/contracts-items.html.twig" with {data: contracts_customer} only %}</div>
			<div class="mt-3">{% include "@organizations/manager/components/pagination.html.twig" with {data: contracts_customer} only %}</div>
        </div>
	</div>
{% endblock %}
