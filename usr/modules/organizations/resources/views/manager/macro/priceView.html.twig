{% macro priceView(price) %}
	{% set pl = price|round|length %}
	{% set new_price = 0 %}
	{% set postfix = false %}
	{% if pl >= 4 and pl < 7 %}
		{% set new_price = price / 1000 %}
		{% set postfix = "тыс" %}
	{% elseif pl >=7 and pl < 10 %}
		{% set new_price = price / 1000000 %}
		{% set postfix = "млн" %}
    {% elseif pl >= 10 and pl < 13 %}
		{% set new_price = price / 1000000000 %}
		{% set postfix = "млрд" %}
    {% elseif pl >= 13 and pl < 16 %}
		{% set new_price = price / 1000000000000 %}
		{% set postfix = "трлн" %}
	{% else %}
		{% set new_price = price %}
	{% endif %}
	<div class="price-view d-flex align-items-baseline" style="gap: 5px;">
		<div class="price-view__price">
		{% if new_price == 0 %}0{% else %}{{new_price|number_format(2, ',', '&nbsp;')|trim('0')|trim(',')|raw}}{% endif %}
		</div>
		{% if postfix %}
		<div class="price-view__postfix">{{postfix}}</div>
		{% endif %}
	</div>
{% endmacro %}
