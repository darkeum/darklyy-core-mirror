{% set total = bank_detail.sum - bank_pay_total %}
{% if total > 0 %}
	<div class="mb-3 btn-group">
		<button type="button" class="btn btn-success" id="button-append">Добавить</button>
	</div>
{% endif %}
<div class="d-flex">
	<div>Осталось распределить:</div>
	<div class="fw-bold ms-2">{{total|number_format(2, ',', ' ')}}</div>
	<div class="ms-1">₽</div>
</div>
<table class="table table-striped">
	<thead>
		<tr>
			<td>Уникальный идентификатор</td>
			<td>Документ</td>
			<td>Сумма, ₽</td>
			<td>Действия</td>
		</tr>
	</thead>
	<tbody id="detail-tbody" data-module="{{bank_detail.module}}">
		{% for item in bank_pay|reverse %}
			{% if bank_detail.module == "sales" %}
				{% set link = "/administration/module/sales/order/#{item.pid}" %}
				{% set document = "Заказ №#{item.sales.numb} #{item.sales.organization.name}" %}
			{% elseif bank_detail.module == "supply_order" %}
				{% set link = "/administration/module/supply/order_detail/#{item.pid}" %}
				{% set document = "Счёт от поставщика №#{item.supply_order.numb}" %}
			{% else %}
				{% set link = false %}
				{% set document = "Оплата модуля: #{bank_detail.module} id: #{item.pid}" %}
			{% endif %}
			<tr id="tr_{{item.id}}" data-id="{{item.id}}">
				<td class="item-id">{{item.id}}</td>
				<td class="item-document" data-pid="{{item.pid}}" data-module="{{bank_detail.module}}">{{document}}</td>
				<td class="item-sum">{{item.sum|number_format(2, ',', ' ')}}</td>
				<td class="item-buttons">
					<div class="item-buttons-group btn-group">
						{% if link %}
							<a href="{{link}}" target="_blank" class="btn btn-sm btn-info">Перейти</a>
						{% endif %}
						<button type="button" class="btn btn-primary btn-sm button-edit" data-id="{{item.id}}">Редактировать</button>
						<button type="button" class="btn btn-danger btn-sm button-delete" data-id="{{item.id}}">Удалить</button>
					</div>
				</td>
			</tr>
		{% endfor %}
	</tbody>
</table>
