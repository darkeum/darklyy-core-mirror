{% extends "_layout/base-layout.html.twig" %}

{% block  header_title %}Загрузка банковской выписки
{% endblock header_title %}

{% block  header_nav %}
	{{ include('@bank/manager/nav_list.html.twig') }}
{% endblock header_nav %}

{% block scripts %}
    <script>
        function select_sales_init(){
            {{select_sales.js|raw}}
        }
        function select_supply_order_init(){
            {{select_supply_order.js|raw}}
        }
    </script>
	{{ assets({files: [
        '@bank_/resources/js/create.js',
    ], name: 'script.js'}) }}
{% endblock %}

{% block  content %}
	<style>
		#bank-form {
			display: grid;
			grid-row-gap: 20px;
		}
	</style>
	<div id="content">
		<div class="card">
			<div class="card-body">
				<form id="bank-form" onsubmit="return false;">
					<div class="input-group">
						<input type="file" class="form-control" name="file" id="bank-file">
						<button type="button" class="btn btn-primary btn-sm" id="bank-button-clear">Очистить</button>
					</div>
					<div id="bank-info" style="display: none;"></div>
					<div id="bank-table-container" style="display: none;">
						<table class="table" id="bank-table">
							<thead>
								<tr>
									<th>Название платежа</th>
									<th>Сумма, ₽</th>
									<th>Тип платежа</th>
									<th>Назначение платежа</th>
									<th>Действия</th>
								</tr>
							</thead>
							<tbody id="bank-table-tbody"></tbody>
						</table>
					</div>
					<div id="bank-buttons" style="display: none;">
						<button class="btn btn-primary" id="bank-button-load" type="button">Загрузить</button>
					</div>
				</form>
			</div>
		</div>
	</div>
{% endblock content %}
