{% extends "_layout/base-layout.html.twig" %}

{% block  header_title %} {{ __('certificates.manager') }} {% endblock header_title %}

{% block  header_nav %}
	{% include '@certificates/manager/header_nav.html.twig' %}
{% endblock header_nav %}

{% block content %}  
	<style>
		.fancybox-slide--iframe .fancybox-content {
			width  : 800px;
			height : 600px;
			max-width  : 80%;
			max-height : 80%;
			margin: 0;
		}
	</style>
	<div id="content" class="">
		<form id="admin-form" action="{% if id is defined %} {{ router('admin.certificates.'~ type, id) }} {% else %} {{ router('admin.certificates.'~ type) }} {% endif %}" method="post">
			{% if id is defined %}
			<input name="_method" type="hidden" value="PUT">
			{% endif %}
			<div class="row">
				<div class="col-md-12 mb-3">
					<div class="card">
						<div class="card-body">
							<div class="row align-items-center">
								<div class="col-md-6">
									<h3 class="mb-0">{% if id is defined %}{{ __('certificates.editor.edited') }}{% else %}{{ __('certificates.editor.added') }}{% endif %}</h3>
								</div>
								<div class="col-md-6 text-end">
									<input name="submit" type="submit" class="btn btn-primary btn-lg" value="{{ do }}">
								</div>
							</div>
						</div>
			  		</div>
				</div>
				<div class="col-md-6">
					<div class="panel panel-dark panel-border top">
						<div class="panel-heading"><span class="panel-title">{{ __('certificates.editor.info') }}</span></div>
						<div class="panel-body">	
							<div class="mb-3">
								<label for="title" class="form-label">{{ __('certificates.editor.title') }}</label>
								<input type="text" class="form-control" name="title" id="title" aria-describedby="titleHelp" value="{{ data.title }}" placeholder="{{ __('certificates.editor.title.placeholder') }}" />
								<div id="titleHelp" class="form-text">{{ __('certificates.editor.title.description') }}</div>
				  			</div>
							<div class="mb-3">
								<label for="slug" class="form-label">{{ __('certificates.editor.slug') }}</label>
								<input type="text" class="form-control" name="slug" id="slug" aria-describedby="slugHelp" value="{{ data.slug }}" placeholder="{{ __('certificates.editor.slug.placeholder') }}" />
								<div id="slugHelp" class="form-text">{{ __('certificates.editor.slug.description') }}</div>
				  			</div>							
							<div class="mb-3">
								<label for="category" class="form-label">{{ __('certificates.editor.category') }}</label>
									<select class="form-select" name="category" id="category" aria-describedby="categoryHelp">
										{% for cat in categories %} 											
											<option value="{{ cat.id }}" {% if data.category == cat.id  %} selected {% endif %}>{{ cat.name }}</option>
										{% endfor %}  
									</select>
								<div id="categoryHelp" class="form-text">{{ __('certificates.editor.category.description') }}</div>
				  			</div>
							<div class="mb-3">
								<label for="date_start" class="form-label">{{ __('certificates.editor.date_start') }}</label>
								<input type="date" class="form-control" name="date_start" id="date_start" aria-describedby="date_startHelp" value="{{ data.date_start|date('Y-m-d') }}" placeholder="{{ __('certificates.editor.date_start.placeholder') }}" />
								<div id="date_startHelp" class="form-text">{{ __('certificates.editor.date_start.description') }}</div>
						 	</div>
							<div class="mb-3">
								<label for="date_end" class="form-label">{{ __('certificates.editor.date_end') }}</label>
							<input type="date" class="form-control" name="date_end" id="date_end" aria-describedby="date_endHelp" value="{% if data.date_end is not empty %}{{ data.date_end|date('Y-m-d') }}{% endif %}" placeholder="{{ __('certificates.editor.date_end.placeholder') }}" />
								<div id="date_endHelp" class="form-text">{{ __('certificates.editor.date_end.description') }}</div>
						 	</div>
							<div class="mb-3">
								<label for="org_name" class="form-label">{{ __('certificates.editor.org_name') }}</label>
								<input type="text" class="form-control" name="org_name" id="org_name" aria-describedby="org_nameHelp" value="{{ data.org_name }}" placeholder="{{ __('certificates.editor.org_name.placeholder') }}" />
								<div id="org_nameHelp" class="form-text">{{ __('certificates.editor.org_name.description') }}</div>
				  			</div>
							<div class="mb-3">
								<label for="numb" class="form-label">{{ __('certificates.editor.numb') }}</label>
								<input type="text" class="form-control" name="numb" id="numb" aria-describedby="numbHelp" value="{{ data.numb }}" placeholder="{{ __('certificates.editor.numb.placeholder') }}" />
								<div id="numbHelp" class="form-text">{{ __('certificates.editor.numb.description') }}</div>
				  			</div>
							<div class="mb-3">
								<label for="tags" class="form-label">{{ __('certificates.editor.tags') }}</label>
								<input type="text" class="form-control" name="tags" id="tags" aria-describedby="tags" value="{{ data.tags|join(', ') }}" placeholder="{{ __('certificates.editor.tags.placeholder') }}" />
								<div id="tagsHelp" class="form-text">{{ __('certificates.editor.tags.description') }}</div>
						 	</div>
							<div class="mb-3">
								<label for="preview" class="form-label">{{ __('certificates.editor.preview') }}</label>
								<div class="input-group">									
								 	<input type="text" id="preview" name="preview" class="form-control" placeholder="{{ __('certificates.editor.preview.placeholder') }}" value="{{ data.preview.source }}" />
								 	<button class="btn btn-outline-secondary" type="button" id="button-preview" data-fancybox="" data-type="iframe" data-src="/filemanager/filemanager.php?type=1&amp;field_id=preview&amp;relative_url=0&amp;fldr=certificates/{% if id is defined %}{{ id }}{% else %}temp{% endif %}"><i class="fas fa-folder-open"></i></button>								
						   		</div>
								<div id="previewHelp" class="form-text">{{ __('certificates.editor.preview.description') }}</div>   
							</div>				
						</div>
					</div>
				</div>
				<div class="col-md-6">				
					<script src="https://cdnjs.cloudflare.com/ajax/libs/tinymce/5.8.2/tinymce.min.js" referrerpolicy="origin"></script>
					<script>
						tinymce.init({
							selector: 'textarea#short',							
						});
						tinymce.init({
							selector: 'textarea#full',							
						});						
					</script>	
					<div class="panel panel-dark panel-border top md-3">
						<div class="panel-heading"><span class="panel-title">{{ __('certificates.editor.short') }}</span></div>
						<div class="panel-body">								
							<div class="mb-3">
								<label for="short" class="form-label">{{ __('certificates.editor.short') }}</label>
								<textarea name="short" id="short" placeholder="{{ __('certificates.editor.short.description') }}">{{ data.short }}</textarea>
								<div id="shortHelp" class="form-text">{{ __('certificates.editor.short.description') }}</div>
							</div>								
						</div>		
					</div>
					<div class="panel panel-dark panel-border top md-3">
						<div class="panel-heading"><span class="panel-title">{{ __('certificates.editor.full') }}</span></div>
						<div class="panel-body">									
							<div class="mb-3">
								<label for="full" class="form-label">{{ __('certificates.editor.full') }}</label>
								<textarea name="full" id="full" placeholder="{{ __('certificates.editor.full.description') }}">{{ data.full }}</textarea>
								<div id="fullHelp" class="form-text">{{ __('certificates.editor.full.description') }}</div>
							</div>								
						</div>		
					</div>
					<div class="panel panel-dark panel-border top">
						<div class="panel-heading"><span class="panel-title">{{ __('certificates.editor.seo') }}</span></div>
						<div class="panel-body">	
							<div class="mb-3">
								<label for="fulltitle" class="form-label">{{ __('certificates.editor.fulltitle') }}</label>
								<input type="text" class="form-control" name="fulltitle" id="fulltitle" aria-describedby="fulltitleHelp" value="{{ data.fulltitle }}" placeholder="{{ __('certificates.editor.fulltitle.placeholder') }}" />
								<div id="fulltitleHelp" class="form-text">{{ __('certificates.editor.fulltitle.description') }}</div>
							</div>
							<div class="mb-3">
								<label for="description" class="form-label">{{ __('certificates.editor.description') }}</label>
								<input type="text" class="form-control" name="description" id="description" aria-describedby="descriptionHelp" value="{{ data.description }}" placeholder="{{ __('certificates.editor.description.placeholder') }}" />
								<div id="descriptionHelp" class="form-text">{{ __('certificates.editor.description.description') }}</div>
							</div>
							<div class="mb-3">
								<label for="keywords" class="form-label">{{ __('certificates.editor.keywords') }}</label>
								<input type="text" class="form-control" name="keywords" id="keywords" aria-describedby="keywordsHelp" value="{{ data.keywords }}" placeholder="{{ __('certificates.editor.keywords.placeholder') }}" />
								<div id="keywordsHelp" class="form-text">{{ __('certificates.editor.keywords.description') }}</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</form>
    </div>
{% endblock content %} 