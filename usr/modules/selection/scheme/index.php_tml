<!doctype html>
<html lang="ru">
 
<head>
    <meta charset="UTF-8">
    <title>Atri-Energo</title>
	<link rel="stylesheet" media="all" href="/css/style.css"/>
</head>
 
<body>

<header>
    <div id="logo"><img src="/images/logo-default.png" alt=""/></div>
    <button class="btn btnRed"><i class="fa fa-calculator" aria-hidden="true"></i> Рассчитать стоимость</button>
    <div id="mapTrash" class="atimate" tooltip="Очистить" flow="down"><i onclick="removeMap()" class="fa fa-trash"  aria-hidden="true"></i></div>
    <div id="myCircuit" class="atimate" tooltip="Мои схемы" flow="down"><i onclick="" class="fa fa-database"  aria-hidden="true"></i></div>
    <div id="myCircuit" class="atimate" tooltip="Типовые решения" flow="down"><i onclick="" class="fa fa-sitemap"  aria-hidden="true"></i></div>
</header>


<div id="blockLeft">

    <div class="draggable blockLeftCont">
        <h3>Блок ввода</h3>
        <img class="blockImg" src="/images/model/block_vvoda.png" data-type="block" data-image="block_vvoda/1.png" data-h1="29" data-h2="29" data-c1="90" data-c2="90" alt=""/>
    </div>

    <hr />

    <div class="draggable blockLeftCont">
        <h3>Блок ГВС</h3>
        <img class="blockImg" src="/images/model/block_gvs.png" data-type="block" data-image="block_vvoda/2.png" data-h1="29" data-h2="29" data-c1="90" data-c2="90" alt=""/>
    </div>

    <hr />

    <div class="draggable blockLeftCont">
        <h3>Блок отоплнения</h3>
        <img class="blockImg" src="/images/model/block_otoplenie.png" data-type="block" data-image="1.png" data-h1="32" data-h2="32" data-c1="94" data-c2="94" alt=""/>
    </div>

    <hr />

    <div class="draggable blockLeftCont">
        <h3>Блок подпитки</h3>
        <img class="blockImg" src="/images/model/block_podpitky.png" data-type="block" data-image="1.png" data-h1="32" data-h2="32" data-c1="94" data-c2="94" alt=""/>
    </div>

    <hr />

    <div class="draggable blockLeftCont">
        <h3>Распределительный блок</h3>
        <img class="blockImg" src="/images/model/block_raspr.png" data-type="block" data-image="1.png" data-h1="32" data-h2="32" data-c1="94" data-c2="94" alt=""/>
    </div>




</div>
<div id="blockRight">
	<div id="blockRightWrap">
      <div class="lineTop">
          <div class="lineTopLeft"></div>
          <div class="lineTopRight"></div>
      </div>
      <div class="lineLeft"></div>

	<div id="constructMap">

		<div class="MapStr">
			<div class="MapBlock1">
                <div id="heatNetworkUnit">
                    <div id="joiningFeeder">Присоединение к подающему <span>трубопроводу по мосту</span></div>
                    <span class="thermalNetwork">Тепловая сеть</span>
                    <div id="attachReverse">Присоединение к обратному <span>трубопроводу по мосту</span></div>
                </div>
				<div class="heat"></div>
                <div class="heatColdIndent"></div>
				<div class="cold"></div>
			</div>
			<div class="MapBlockImg"></div>
		</div>

        <div class="MapStr">
            <div class="MapBlock1"></div>
            <div class="MapBlockImg"></div>
        </div>



		<div class="clear"></div>

        <svg id="svg-line">
            <line></line>
        </svg>
	</div>




        
    </div>
</div>






<link rel="stylesheet" href="/css/font-awesome.min.css">
<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
<script src="/js/jquery-ui.min.js"></script>
<script src="/js/jquery.nicescroll.min.js"></script>
<script src='/js/scripts.js'></script>
</body>
 
</html>