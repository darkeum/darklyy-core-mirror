{% extends "_layout/base-layout.html.twig" %}

{% block  header_title %}{% endblock header_title %}

{% block  header_nav %}
    {{ include('@report/manager/nav_list.html.twig') }}
{% endblock header_nav %}

{% block scripts %}
    
{% endblock %}

{% block links %}
	
{% endblock %}

{% block  content %}
    <style>
        .card-item{
            min-height: 100px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 25px;
            background-color: grey;
            color: #e5e5e5;
        }
    </style>
    <div id="content">
        <div class="card">
            <div class="card-header">
                <h4>Список отчётов</h4>
            </div>
            <div class="card-body">
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-5">
                    {% for item in items %}
                        <div class="col">
                            <a href="{{item.router}}">
                                <div class="card-item mb-2"><i class="fas fa-image"></i></div>
                                <div class="text-body fw-bold">{{item.title}}</div>
                                <hr class="m-2">
                                <div class="text-muted">{{item.description}}</div>
                            </a>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
{% endblock content %}