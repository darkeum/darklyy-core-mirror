{% extends "_layout/base-layout.html.twig" %}

{% block  header_title %}{% endblock header_title %}

{% block  header_nav %}
    {{ include('@report/manager/nav_list.html.twig') }}
{% endblock header_nav %}

{% block scripts %}
	  {{ assets({files: [
        "@report_/resources/js/index.js",
    ], name: 'script.js'}) }}
    {{additional_js|raw}}
{% endblock %}

{% block links %}
	{{ assets({files: [
        "@report_/resources/css/index.css",
    ],  name: "style.css"})}}
    {{additional_css|raw}}
{% endblock %}

{% block  content %}
    <input type="hidden" id="Report_name" value="{{Report_name}}">

    <input type="hidden" id="link_view" value="{{link.view}}">
    <input type="hidden" id="link_excel" value="{{link.excel}}">
    <input type="hidden" id="download_excel" value="{{router('admin.report.download_excel')}}">
    <input type="hidden" id="modals_data" value="{{modals_data|json_encode}}">
    <div id="content">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="d-flex align-items-center">
                        <h3>{{title}}</h3>
                        <button type="button" class="btn btn-sm btn-success ms-5" @click="addSelection">Добавить отбор</button>
                    </div>
                    <div class="btn-group">
                        <button type="button" class="btn btn-sm btn-warning" @click="generate">Сформировать</button>
                        <button type="button" class="btn btn-sm btn-info" @click="excel">Скачать excel</button>
                    </div>
                </div>
                <div id="Report-setting">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Активность</th>
                                <th>Фильтр</th>
                                <th>Условие</th>
                                <th>Значение</th>
                                <th>Действие</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr v-for="(selection, index) in selections">
                                <td>
                                    <label class="switch" :for="'checkbox-'+index">
                                        <input type="checkbox" :id="'checkbox-'+index" :checked="selection.active" @change="changeActive(selection)">
                                        <div class="slider round"></div>
                                    </label>
                                </td>
                                <td>
                                    <select class="form-select" v-model="selection.field" @change="changeField(selection)">
                                        {% for field in fields %}
                                            <option value="{{field.value}}">{{field.text}}</option>
                                        {% endfor %}
                                    </select>
                                </td>
                                <td>
                                    <select class="form-select" v-model="selection.condition" @change="changeCondition(selection)">
                                        <option :value="key" v-for="(condition, key) in getConditions(selection, index)">${condition}</option>
                                    </select>
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center align-items-center cp" @click="changeValue(selection, index)">
                                        <div v-if="Array.isArray(selection.value) && selection.value.length > 0">
                                            ${selection.value_view.join(", ")}
                                        </div>
                                        <div v-else-if="!Array.isArray(selection.value) && selection.value">${selection.value_view}</div>
                                        <div v-else><i class="fas fa-plus text-success cp" title="Добавить значение"></i></div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex justify-content-center align-items-center">
                                        <i class="fas fa-times text-danger cp" title="Удалить" @click="deleteSelection(index)"></i>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <form onsubmit="return false;" id="additional_terms">{{additional_terms|raw}}</form>
                <hr>
                <div id="Report-body"></div>
            </div>
        </div>

        <div class="modal fade" id="listModal" aria-labelledby="exampleModalLabel" aria-hidden="true">
          <div class="modal-dialog">
            <div class="modal-content">
              <div class="modal-header">
                {# <h5 class="modal-title" id="exampleModalLabel">Список</h5> #}
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
              <div class="modal-body">
                    <div v-if="list_value.length">
                        <div v-for="(item, index) in list_value" class="d-flex" :key="index">
                            <div>${item}</div>
                            <div class="ms-3"><i class="fas fa-times text-danger cp" @click="deleteItemList(index)"></i></div>
                        </div>
                    </div>
                    <div v-else>Не выбрано</div>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-primary" id="listModalButton">Добавить</button>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
              </div>
            </div>
          </div>
        </div>

    </div>

    {% for modal in modals %}
        <input type="hidden" id="{{modal.condition.input}}" value="{{modal.condition.text|json_encode}}">
        {{modal.template|raw}}
    {% endfor %}
{% endblock content %}