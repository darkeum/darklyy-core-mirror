{% extends "_layout/base-layout.html.twig" %}

{% block  header_title %} {{ __('job_manager') }} {% endblock header_title %}

{% block  header_nav %}
    <ul class="nav nav-list nav-list-topbar"> 
        <li class=""><a href="{{ router('admin.job.index') }}">{{ __('job_list') }} </a> </li>
        <li class="{% if id is not defined %} active {% endif %}"><a href="{{ router('admin.job.create') }}">{{ __('job_add') }} </a> </li> 
    </ul>
{% endblock header_nav %}

{% block  content %}  
	<style>

	</style>
	<div id="content" class="">
		<div class="panel panel-dark panel-border top">
			<div class="panel-heading"><span class="panel-title">{{ title }}</span></div>
			<div class="panel-body admin-form">
				<form id="admin-form" action="{% if id is defined %} {{ router('admin.job.update', id) }} {% else %} {{ router('admin.job.store') }} {% endif %}" method="post"  class="form-horizontal parsley-form">
					{% if id is defined %}
					<input name="_method" type="hidden" value="PUT">
					{% endif %}
					<div class="row form-group mb-3 align-items-center">
						<label for="category" class="col-lg-3 control-label text-end">{{ __('job_editor_category') }}</label>
						<div class="col-lg-3">
								<label class="field select">
									<select class="form-control" name="category" id="category">
										{% for cat in categories %} 											
										  	<option value="{{ cat.id }}" {% if data.category == cat.id  %} selected {% endif %}>{{ cat.name }}</option>
										{% endfor %}  
									</select><i class="arrow double"></i>
								</label>
						</div>
					</div>
					<div class="row form-group mb-3 align-items-center">
						<label for="category" class="col-lg-3 control-label text-end">{{ __('job_editor_responsible') }}</label>
						<div class="col-lg-3">
								<label class="field select">
									<select class="form-control" name="responsible" id="responsible">
										<option value="0">{{ __('job_editor_responsible_empty') }}</option>
										{% for u in users %} 											
										  	<option value="{{ u.id }}" {% if data.responsible == u.id  %} selected {% endif %}>{{ u.surname }} {{ u.name }} {{ u.ochestvo }}</option>
										{% endfor %}  
									</select><i class="arrow double"></i>
								</label>
						</div>
					</div>
					<div class="row form-group mb-3 align-items-center">
						<label for="title" class="col-lg-3 control-label text-end">{{ __('job_editor_title') }}</label>
						<div class="col-lg-3">
							<label for="title" class="field prepend-icon">
								<input id="title" type="text" name="title" value="{{ data.title }}" placeholder="{{ __('job_editor_title_placeholder') }}" class="gui-input" onchange="getTranslit(gi('title').	value, 'slug');">
								<label for="title" class="field-icon"><i class="far fa-pencil"></i></label>
							</label>
						</div>
					</div> 
					<div class="row form-group mb-3 align-items-center">
						<label for="slug" class="col-lg-3 control-label text-end">{{ __('job_editor_slug') }}</label>
						<div class="col-lg-3">
							<label for="slug" class="field prepend-icon">
								<input id="slug" type="text" name="slug" value="{{ data.slug }}" placeholder="{{ __('job_editor_slug_placeholder') }}" class="gui-input" />
								<label for="slug" class="field-icon"><i class="far fa-link"></i></label>
							</label>
						</div>
					</div>
					<div class="row form-group mb-3 align-items-center">
						<label class="col-sm-3 control-label text-end">{{ __('job_editor_description') }}</label>
						<div class="col-sm-4">
							<label for="description" class="field prepend-icon">
								<textarea name="description" id="description" placeholder="{{ __('job_editor_description_placeholder') }}" class="gui-textarea">{{ data.description }}</textarea>
								<label for="description" class="field-icon"><i class="far fa-comments"></i></label>
							</label>
						</div>
					</div>
					<div class="row form-group mb-3 align-items-center">
						<label class="col-sm-3 control-label text-end">{{ __('job_editor_salary') }}</label>
						<div class="col-sm-4">
							<label for="salary" class="field prepend-icon">
								<input id="salary" type="text" name="salary" value="{{ data.salary }}" placeholder="{{ __('job_editor_salary_placeholder') }}" class="gui-input" />
								<label for="salary" class="field-icon"><i class="far fa-rub"></i></label>
							</label>
						</div>
					</div>
					<div class="row form-group mb-3 align-items-center">
						<label class="col-sm-3 control-label text-end">{{ __('job_editor_conditions') }}</label>
						<div class="col-sm-4">
							<label for="conditions" class="field prepend-icon">
								<textarea name="conditions" id="conditions" placeholder="{{ __('job_editor_conditions_placeholder') }}" class="gui-textarea">{{ data.conditions }}</textarea>
								<label for="conditions" class="field-icon"><i class="far fa-comment-alt-check"></i></label><span class="input-footer"><strong>{{ __('job_editor_attention') }}: </strong>{{ __('job_editor_conditions_info') }}</span>
							</label>
						</div>
					</div>
					<div class="row form-group mb-3 align-items-center">
						<label class="col-sm-3 control-label text-end">{{ __('job_editor_duties') }}</label>
						<div class="col-sm-4">
							<label for="duties" class="field prepend-icon">
								<textarea name="duties" id="duties" placeholder="{{ __('job_editor_duties_placeholder') }}" class="gui-textarea">{{ data.duties }}</textarea>
								<label for="duties" class="field-icon"><i class="far fa-comment-alt-exclamation"></i></label><span class="input-footer"><strong>{{ __('job_editor_attention') }}: </strong>{{ __('job_editor_duties_info') }}</span>
							</label>
						</div>
					</div>
					<div class="row form-group mb-3 align-items-center">
						<label class="col-sm-3 control-label text-end">{{ __('job_editor_requirements') }}</label>
						<div class="col-sm-4">
							<label for="requirements" class="field prepend-icon">
								<textarea name="requirements" id="requirements" placeholder="{{ __('job_editor_requirements_placeholder') }}" class="gui-textarea">{{ data.requirements }}</textarea>
								<label for="requirements" class="field-icon"><i class="far fa-comment-alt-medical"></i></label><span class="input-footer"><strong>{{ __('job_editor_attention') }}:</strong>{{ __('job_editor_requirements_info') }}</span>
							</label>
						</div>
					</div>
					<div class="row form-group">
						<label class="col-sm-3 control-label"></label>
						<div class="col-sm-4">
							<input name="submit" type="submit" class="btn btn-primary btn-parsley" value="{{ do }}">
						</div>
					</div>
				</form>
			</div>
		</div>
    </div>
{% endblock content %}