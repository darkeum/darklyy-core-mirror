<div class="row">
	{% include buttons_path %}
	<div class="col d-flex flex-column gap-3">
		<div>
			<div>Поставщик</div>
			<div class="fw-bold">{{control.supply_order.organization.name}}</div>
		</div>
		<div>
			<div>Ответственный</div>
			<div class="fw-bold">{{control.user.short_user_name}}</div>
		</div>
		<div>
			<div>Дата создания</div>
			<div class="fw-bold">{{control.date|date("d.m.Y H:i:s")}}</div>
		</div>
	</div>
	<div class="col d-flex flex-column gap-3">
		<div>
			<div>Статус</div>
			<div class="fw-bold">{{control.status_view}}</div>
		</div>
		<div>
			<div>Оплата</div>
			<div class="fw-bold">{{control.pay_view}}</div>
		</div>
		<div>
			<div>Дата оплаты</div>
			<div class="fw-bold">
				<span id="plan_pay_date" data-pk="{{id}}" data-value="{{control.plan_pay_date}}">{{control.plan_pay_date}}</span>
			</div>
		</div>
	</div>
	<div class="col d-flex flex-column gap-3">
		<div>
			<div>Счёт поставщика</div>
			<div class="fw-bold">
				<a href='/administration/module/supply/order_detail/{{control.supply_o}}' target='_blank'>{{control.supply_order.numb}}</a>
			</div>
		</div>
		<div>
			<div>Привязанные продажи</div>
			<div>
				{% for sale in sales %}
					<div class="fw-bold">
						<a href="/administration/module/sales/order/{{sale.id}}" target='_blank'>{{sale.numb}}</a>
						-
						<a href="/administration/object/view/{{sale.object_.id}}" target='_blank'>{{sale.object_.name}}</a>
					</div>
				{% else %}
					<div class="fst-italic">Отсутствует</div>
				{% endfor %}
			</div>
		</div>
	</div>
	<div class="col d-flex flex-column gap-3">
		<div>
			<div>Документы по счету</div>
			<div>
				{% for item in attach %}
					<div>
						<a target="_blank" href="/download/{{item.id}}">{{item.name}}</a>
					</div>
				{% else %}
					<div class="fst-italic">Отсутствует</div>
				{% endfor %}
			</div>
		</div>
		<div>
			<div>Комментарии</div>
			<div>
				{% for comment in comments %}
					<div class="border p-2">
						<div class="fw-bold">{{comment.user.short_user_name}}
							{{comment.date|date("d.m.Y")}}</div>
						<div>{{comment.text}}</div>
					</div>
				{% else %}
					<div class="fst-italic">Отсутствует</div>
				{% endfor %}
			</div>
		</div>
	</div>
</div>
