{% if control.status != 2 %}
<div class="col d-flex flex-column gap-3">
    <div class="holder-container">
        {% if control.status == 1 %}
            <div class="holder-style holder-active" id="button-approve">
				<i class="far fa-check-circle holder-icon"></i>Согласовать (на оплату)
            </div>
            <div class="holder-style holder-active" id="button-revision">
				<i class="far fa-times-circle holder-icon"></i>Отправить на доработку
            </div>
        {% endif %}
        {% if control.status == 3 %}
            <div class="holder-style holder-active" id="button-cancel_approve">
				<i class="fas fa-minus-circle holder-icon"></i>Отменить согласование
            </div>
        {% endif %}
    </div>
</div>
{% endif %}