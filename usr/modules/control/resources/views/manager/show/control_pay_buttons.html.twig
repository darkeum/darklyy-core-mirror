{% if control.pay != 2 %}
<div class="col d-flex flex-column gap-3">
    <div class="holder-container">
        {% if control.pay == 0 %}
            <div class="holder-style holder-active" id="button-pay">
				<i class="far fa-check-circle holder-icon"></i>Оплатить
            </div>
        {% endif %}
        {% if control.pay != 2 %}
            <div class="holder-style holder-active" id="button-cancel-pay">
				<i class="far fa-times-circle holder-icon"></i>Отмена оплаты
            </div>
        {% endif %}
    </div>
</div>
{% endif %}