<div class="modal fade" id="attributeValue{{typeModal}}Modal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<form id="attributeValueForm{{typeModal}}Modal" action="{{formAction}}">
				<div class="modal-header">
					<h5 class="modal-title">Значение атрибута</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
				</div>
				<div class="modal-body">
					<div class="form-floating">
						<input type="text" class="form-control" id="attributeValueInput{{typeModal}}Modal" name="value" required>
						<label for="attributeValueInput{{typeModal}}Modal">Значение атрибута</label>
					</div>
					<div id="attributeValueInputs{{typeModal}}Modal"></div>
				</div>
				<div class="modal-footer">
					<button type="submit" class="btn btn-primary" id="attributeValueBtnModal">{{submitValue}}</button>
					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
				</div>
			</form>
		</div>
	</div>
</div>
