{% extends "_layout/base-layout.html.twig" %}

{% block  header_title %}{% endblock header_title %}

{% block  header_nav %}
	{{ include('@catalog/manager/nav_list.html.twig') }}
{% endblock header_nav %}

{% block scripts %}
	<script src="/usr/tpl/admin/assets/js/Sortable.js"></script>
	<script>
		const adminUsers = [{{adminUsers|join(', ')}}];
		const uid = {{ user.id }};
		const attributes = {{ attributes|json_encode|raw }};
	</script>
	{{ assets({files: [
        "@catalog_/resources/js/attribute.js",
        ], name: 'script.js'}) }}
{% endblock %}

{% block links %}
	{{ assets({files: [
        "@catalog_/resources/css/attribute.css",
    ]}) }}
{% endblock %}

{% block  content %}
	<div id="content">
		<div class="row">
			<div class="col-3">
				<div class="card">
					<div class="card-body">
						<div>
							<input type="button" class="btn btn-primary" value="Добавить общий атрибут" id="addAttributeModal">
						</div>
						<div class="mt-3">
							<label for="category">
								Категория
							</label>
							<select id="category" class="form-select">
								<option value="" selected disabled>Выберите категорию</option>
								{% for category_id, category_value in categories %}
									<option value="{{category_id}}">{{category_value}} ({{category_id}})</option>
								{% endfor %}
							</select>
						</div>
						<div class="mt-3">
							<label for="attribute">Выберите атрибут</label>
							<div class="input-group flex-nowrap">
								<select id="attribute" class="form-select"></select>
								<button class="btn btn-outline-secondary" type="button" id="editAttributeCategory" disabled data-bs-toggle="modal" data-bs-target="#attributeCategoryModal">
									<i class="fas fa-sort-amount-down"></i>
								</button>
							</div>
						</div>
						<div class="mt-3 text-center">ИЛИ</div>
						<div class="mt-3">
							<label for="attribute">
								Выберите атрибут
							</label>
							<select id="attribute_all" class="form-select"></select>
						</div>
					</div>
				</div>
			</div>
			<div class="col-9">
				<div class="card" style="height: 100%;">
					<div class="card-body">
						<div id="attribute_data">
							<div v-if="attribute_show">
								<div class="mb-2">
									<div class="btn-group" id="attribute_buttons">
										<button type="button" class="btn btn-success" v-if="attribute_data.data.type == 'selection'" @click="addAttributeValueModal">Добавить</button>
										<button type="button" class="btn btn-primary" @click="editAttributeModal">Редактировать</button>
										<button type="button" class="btn btn-danger" @click="deleteAttributeModal" v-if="isAdmin">Удалить</button>
									</div>
								</div>
								<div>
									<h3>Атрибут: ${attribute_data.data.name}</h3>
								</div>
								<div class="mt-2">Тип атрибута:
									<b>${attribute_data.data.type_view}</b>
								</div>
								<div class="mt-2">Блокировка атрибута:
									<b>${attribute_data.data.blocked == 0 ? "Разблокирован" : "Заблокирован"}</b>
								</div>
								<div class="mt-2 row" id="attribute_data_info">
									<div class="col-5">
										<div class="mt-2">Значения (значения | сохраненные значения):</div>
										<div class="mt-2" id="attribute_items">
											<div class="attribute_item_value row mb-2" v-for="item in attribute_data.data.attribute_value" :key="item.id">
												<div class="col-1 attribute_item_value-move">≡</div>
												<div class="col-7 row">
													<div class="col-6">${item.value}</div>
													<div class="col-6">${item.value_save}</div>
												</div>
												<div class="col-4 text-end">
													<div class="btn-group">
														<button type="button" class="btn btn-sm btn-primary" @click="editAttributeValueModal(item)">
															<i class="fas fa-edit"></i>
														</button>
														<button type="button" class="btn btn-sm btn-danger" @click="deleteAttributeValueModal(item)" v-if="isAdmin">
															<i class="fas fa-times"></i>
														</button>
													</div>
												</div>
											</div>
										</div>
									</div>
									<div class="col-7">Категории:
										<div id="attribute_categories" class="font-weight-bold">
											<div class="category_item" v-for="item in attribute_data.data.attribute_category">
												${attribute_data.categories[item.category_id]}
											</div>
										</div>
									</div>
								</div>
							</div>

							<div class="modal fade" id="attributeCategoryModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
								<div class="modal-dialog">
									<div class="modal-content">
										<div class="modal-header">
											<h5 class="modal-title" id="exampleModalLabel">Атрибуты</h5>
											<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
										</div>
										<div class="modal-body">
											<div class="row">
												<div class="col-8">Атрибут</div>
												<div class="col-4">Действие</div>
											</div>
											<div id="attributeCategoryItemsModal">
												<div v-for="item in attribute_list" :key="item.id" class="attributeCategoryItem row">
													<div class="col-1 attributeCategoryItemMove">≡</div>
													<div class="col-7">${item.name}</div>
													<div class="col-4">
														<label>
															<input type="checkbox" value="1" v-model="item.attribute_category_one.hidden" true-value="1" false-value="0" @change="catalog_attribute_category_update(item.attribute_category_one)">
															Выключен
														</label>
													</div>
												</div>
											</div>
										</div>
										<div class="modal-footer">
											<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
										</div>
									</div>
								</div>
							</div>

						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	{% include '@catalog/manager/attribute/modal/attribute' with {
		'submitValue': 'Добавить', 
		'titleValue': 'Добавить атрибут', 
		'formAction': '/administration/module/catalog/attribute',
		'typeModal': 'Create',
	} %}

	{% include '@catalog/manager/attribute/modal/attribute' with {
		'submitValue': 'Редактировать', 
		'titleValue': 'Редактировать атрибут', 
		'formAction': '/administration/module/catalog/attribute/',
		'typeModal': 'Update',
	} %}


	{% include '@catalog/manager/attribute/modal/value' with {
		'submitValue': 'Добавить', 
		'formAction': '/administration/module/catalog/attribute/value',
		'typeModal': 'Create',
	} %}

	{% include '@catalog/manager/attribute/modal/value' with {
		'submitValue': 'Редактировать', 
		'formAction': '/administration/module/catalog/attribute/value/',
		'typeModal': 'Update',
	} %}

{% endblock content %}
