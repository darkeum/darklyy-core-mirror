<style>
    li {
        list-style-type: none;
        margin-bottom: 20px;
    }
    .submain {
        margin-left: 0; 
        padding-left: 0;
    }
    ul{
        padding-left: 120px;
    }
    .container{
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }
    .container-value{
        padding: 5px;
        border: 1px grey solid;
        border-radius: 10px;
        min-width: 20px;
        text-align: center;
        cursor: pointer;
        transition: .3s;
    }
    .container-value:hover{
        background-color: #e9e9e9;
    }
    .copy{
        padding: 10px;
    }
</style>
{% macro tree_build(categories, attribute, categories_attribute, parent_id, main = false) %}
    {% if categories[ parent_id ] %}
        {% if main %}
            <ul class="submain">
        {% else %}
            <ul class="submenu" id="submenu_{{parent_id}}">
        {% endif %}
        {% for cat in categories[ parent_id ] %}
            <li {% if cat.hidden == 1 %}style="color: red;"{% endif %}>
                <p id="point_{{cat.id}}" class="point">
                    <h3>{{cat.id}} - {{cat.name}}</h3>
                </p>
                <ul>
                {% for ca in categories_attribute[ cat.id ] %}
                    {% set attr = attribute[ ca.attribute_id ] %}
                    <li>
                        <div>{{attr.id}} - {{attr.name}}</div>
                        {% if attr.type == "selection" %}
                        <div class="container">
                            {% for av in attr.attribute_value %}
                                <div class="container-value">{{av.value}}</div>
                            {% endfor %}
                        </div>
                        {% endif %}
                    </li>
                {% endfor %}
                </ul>
                {{ _self.tree_build(categories, attribute, categories_attribute, cat.id) }}
            </li>
        {% endfor %}
            </ul>
    {% endif %}
{% endmacro %}

{{ _self.tree_build(categories, attribute, categories_attribute, 0, true) }}

<script>
    document.querySelectorAll(".container-value").forEach(item => {
        item.addEventListener('click', async function(){
            item.classList.add("copy");
            await navigator.clipboard.writeText(item.textContent);
            await sleep(200);
            item.classList.remove("copy");
        })
    })

    async function sleep(ms){
        return new Promise(resolve => setTimeout(resolve, ms));
    }
</script>