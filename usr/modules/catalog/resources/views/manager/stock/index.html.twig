{% extends "_layout/base-layout.html.twig" %}

{% block  header_title %}{% endblock header_title %}

{% block  header_nav %}
    {{ include('@catalog/manager/nav_list.html.twig') }}
{% endblock header_nav %}

{% block scripts %}
    <script>
        function startJob(id){
            Swal.fire({
              title: 'Вы уверены?',
              showDenyButton: true,
              confirmButtonText: 'Запустить',
              denyButtonText: `Отмена`,
            }).then(async (result) => {
              /* Read more about isConfirmed, isDenied below */
              if (result.isConfirmed) {
                await ( await fetch(`/administration/module/catalog/stock_parser/start_job/${id}`) ).text;
                $grid.trigger('reloadGrid');
              }
            })
        }
    </script>
	{{ assets({files: [], name: 'script.js'}) }}
{% endblock %}

{% block links %}
	{{ assets({files: []}) }}
{% endblock %}

{% block  content %}
   {{ grid|raw }}
{% endblock content %}