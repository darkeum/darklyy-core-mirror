<div class="row">
	<div v-if="batch_list.length">
		<table class="table">
			<thead>
				<tr>
					<th>ID</th>
					<th>Наименование</th>
					<th>Прогресс</th>
					<th>Время начала</th>
					<th>Время конца</th>
					<th>Время отмены</th>
					<th>Действия</th>
				</tr>
			</thead>
			<tbody>
				<tr v-for="(batch, index) in batch_list" :key="batch.id">
					<td>${batch.id}</td>
					<td>${batch.name}</td>
					<td :class="{'cp text-center': true, 'text-danger fw-bold': batch.failedJobs > 0}" @click="showMore(batch)">${batch.progress}%</td>
					<td>${moment(batch.createdAt)}</td>
					<td>${moment(batch.finishedAt)}</td>
					<td>${moment(batch.cancelledAt)}</td>
					<td>
						<div class="btn-group">
							<button type="button" class="btn btn-warning" v-if="!batch.cancelledAt && !batch.finishedAt" @click="cancel_batch(index)">Остановить</button>
							<button type="button" class="btn btn-danger" v-if="batch.finishedAt || batch.cancelledAt" @click="delete_batch(index)">Удалить</button>
						</div>
					</td>
				</tr>
			</tbody>
		</table>
	</div>
	<div v-else class="p-3">Процессы отсутствуют</div>
</div>