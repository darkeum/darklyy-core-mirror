<div class="row">
	<div v-if="files.length">
		<table class="table">
			<thead>
				<tr>
					<th>Наименование</th>
					<th>Действия</th>
				</tr>
			</thead>
			<tbody>
				<tr v-for="(file, index) in files" :key="index">
					<td>${file.pathinfo.basename}</td>
					<td>
						<div class="btn-group">
							<button type="button" class="btn btn-primary" @click="get_file(index)">Скачать</button>
						</div>
					</td>
				</tr>
			</tbody>
		</table>
	</div>
	<div v-else class="p-3">Файлы отсутствуют</div>
</div>