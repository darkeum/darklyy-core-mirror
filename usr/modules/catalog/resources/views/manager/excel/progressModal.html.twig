<div class="modal fade" id="progress_{{type}}Modal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="exampleModalLabel">Прогресс</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
                <div v-if="progressModal.data">
                    <div class="row border-bottom py-2">
                        <div class="col-4 text-secondary text-end">Прогресс:</div>
                        <div class="col-8">${progressModal.data.progress}%</div>
                    </div>
                    <div class="row border-bottom py-2">
                        <div class="col-4 text-secondary text-end">Итого работ:</div>
                        <div class="col-8">${progressModal.data.totalJobs}</div>
                    </div>
                    <div class="row border-bottom py-2">
                        <div class="col-4 text-secondary text-end">Выполненных работ:</div>
                        <div class="col-8">${progressModal.data.processedJobs}</div>
                    </div>
                    <div class="row border-bottom py-2">
                        <div class="col-4 text-secondary text-end">Ожидающих работ:</div>
                        <div class="col-8">${progressModal.data.pendingJobs}</div>
                    </div>
                    <div class="row border-bottom py-2">
                        <div class="col-4 text-secondary text-end">Работ с ошибками:</div>
                        <div class="col-8">${progressModal.data.failedJobs}</div>
                    </div>
                </div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
			</div>
		</div>
	</div>
</div>