                                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
												<span aria-hidden="true">&times;</span>
											</button>
                                            </div>
                                            <div class="modal-body">
                                                <style>
                                                    .dm-uploader {
                                                        padding: 0.7rem!important;
                                                    }
                                                    
                                                    .dm-uploader>h3 {
                                                        font-size: 16px;
                                                        margin-bottom: 1.2rem!important;
                                                        margin-top: 1.2rem!important;
                                                    }
                                                    
                                                    .dm-uploader>div.btn {
                                                        width: 70%;
                                                        text-align: center;
                                                        display: inline-block;
                                                        margin-bottom: 1.2rem!important;
                                                    }
                                                </style>

                                                <div id="uploadForm">
                                                    {%UPLOAD_INIT%}
                                                    <br> {%UPLOAD_VIEW%}
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Закрыть</button>
                                                <button class="btn btn-primary">Отправить</button>
                                            </div>
                                        </form>
                                        <script type="text/javascript">
                                            $(function() {
                                                $("#senPresent").on('submit', function(e) {
                                                    e.preventDefault();
                                                    console.log('valid');
                                                    $.post('ajax.php?do=getRequstForPresent', $('#senPresent').serialize(), function(response) {
                                                        result = $.parseJSON(response);
                                                        if (result.statusDownload == '1') {
                                                            $('#getConsultation').modal('hide');
                                                            $('#sendPresentButton').html('<span class="mt-3 text-success"><i class="far fa-check-circle"></i> Ваша заявка отправлена!</span>');
