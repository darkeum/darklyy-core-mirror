                    </div>
                </div>
                <!-- featured-icon-box end-->
            </div>


        </div>

    </div>

</div>


<script>
    $(function() {

        $("#presentForm").on("submit", function(e) {
            e.preventDefault();
            const count = get_count();
            const c_count = get_c_count();
            if (count == c_count) {
                const request = $(this).serialize();
                $.post('ajax.php?do=getMyPresent', request, function(response) {
                    result = $.parseJSON(response);
                    if (result.statusPresent == '1') {
                        //$('#pddInfoText').html('Ваш подарок уже в пути! Не забудьте принять участие в главном розыгрыше, для этого необходимо выложить фотографию с полностью собранным кубиком в социальный сети (Instagram, Вконтакте, Facebook) с хэштегом #АТРИЭНЕРГО2021. Главным призом будет умная колонка Яндекс.Станция Макс ');
                        Swal.fire('Информация', 'Спасибо за выбор подарка, наши сотрудники привезут вам его в течении февраля!', 'success').then((result) => {
                            location.reload();
                        });

                    }
                });


            } else {
                Swal.fire('Ошибка', 'Выберите желаемый подарок!', 'error');
            }
        });

        $(".item_b").on("click", function() {
            const t = $(this);
            const checkbox = t.next();
            const c_flag = !checkbox.prop("checked");
            const btnColor = t.data("btncolor");
            if (c_flag) {
                t.addClass("btn-info");
                t.removeClass(btnColor);
            } else {
                t.addClass(btnColor);
                t.removeClass("btn-info");
            }
            checkbox.prop("checked", c_flag);
            block_btn();
        });

        function get_count() {
            return $("#count_inp").val();
        }

        function get_c_count() {
            return $(".item_c:checked").length;
        }

        function block_btn() {
            const count = get_count();
            const c_count = get_c_count();
            $(".item_c:not(:checked)").prev().prop("disabled", c_count >= count);
        }
    });
</script>