<div class="container" style="display: block; width: 100%;">
	<div class="row">
		<div class="col-md-12">
			<div id="testimonial-slider">
				<div class="testimonial">

					<div class="pic {%AVATAR_CLASS%}">
						{%AVATAR_LEFT%}
						<div class="info-b-text">
							<h2>{%NAME%} <span>{%MYDATE:G:i, d.m.y%}</span></h2>
							<div class="info-b-text-mes"><p>{%COMMENT%}</p></div>
							[reply]
							<div class="testimonial-review">
								<b>Ответ:</b>
								{%REPLY%}
							</div>
							[/reply]
						</div>
						{%AVATAR_RIGHT%}
					</div>

					<!--<h4 class="testimonial-title">
						<small>ИД: {%ID%}, Веб-сайт: {%WEBSITE%},  Телефон: {%PHONE%}, E-mail: {%EMAIL%}, Компания: {%COMPANY%}, Должность: {%POST%}, {%DATE%}


						</small>
					</h4>-->
				</div>
			</div>
		</div>
	</div>
</div>


