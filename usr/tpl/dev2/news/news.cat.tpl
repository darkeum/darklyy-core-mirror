<div class="blog-item col-md-6 col-sm-12">
	<div class="wrap">
		<div class="blog-image">
			<a href="{%FULL_LINK%}"><img class="img-responsive" style="object-fit: cover; height: 250px;" src="{%PREVIEW%}" alt="{%TITLE%}" title="{%TITLE%}"/></a>
		</div>      
		<div class="blog-info">        
			<div class="entry-date">
				<span class="date">{%MYDATE:d%}</span>
				<span class="month">{%MYDATE:M%}</span>
			</div>        
			<h3 class="blog-title"><a href="{%FULL_LINK%}">{%TITLE%}</a></h3>
			<div class="blog-decs clearfix">{%SHORT:70%}</div>
			<span class="comment">{%VIEWS%}<i class="fa fa-eye"></i></span>        
			<a class="read-more" href="{%FULL_LINK%}">Подробнее<i class="fa fa-arrow-circle-right"></i></a>        
		</div>
	</div>
</div>