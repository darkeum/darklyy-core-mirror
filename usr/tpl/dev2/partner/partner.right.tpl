<div class="left-content res-991-pr-0 res-991-pb-40 mb-3">
		<img class="img-fluid w-100" src="{%MAIN_IMAGE%}" alt="{%PARTNER_TITLE%}" title="{%PARTNER_TITLE%}">
		<div class="content-info pt-25 pl-25 pr-25 pb-25 box-shadow">					
			<h5>Контакты:</h5>
			<div class="pt-5">
				<div class="row mb-10">
					<div class="col-4"><b>Телефон:</b></div>
					<div class="col-8"><a href="tel:{%PHONE%}">{%PHONE%}</a></div>
				</div>
				<div class="row mb-10">
					<div class="col-4"><b>Email:</b></div>
					<div class="col-8"><a href="mailto:{%EMAIL%}">{%EMAIL%}</a></div>
				</div>
				<div class="row mb-10">
					<div class="col-4"><b>Сайт:</b></div>
					<div class="col-8"><a target="_blank" href="{%SITE_URL%}">{%SITE%}</a></div>
				</div>					
			</div>
			
			<div class="cmt-horizontal_sep width-100 mt-35 mb-30"></div>
			<h5>Поделиться:</h5>
			<ul class="social-icons circle social-hover cmt-textcolor-skincolor pb-10 {%COLOR_CLASS%}">
				<li class="social-linkedin">
					<a class=" tooltip-top" target="_blank" href="https://vk.com/share.php?url=https://atri-energo.ru/{%FULL_LINK%}" data-tooltip="Вконтакте">
						<i class="fab fa-vk" aria-hidden="true"></i>
					</a>
				</li>
				<li class="social-facebook">
					<a class="tooltip-top" target="_blank" href="https://www.facebook.com/sharer/sharer.php?u=https://atri-energo.ru/{%FULL_LINK%}" data-tooltip="Facebook">
						<i class="fab fa-facebook" aria-hidden="true"></i>
					</a>
				</li>
				<li class="social-twitter">
					<a class="tooltip-top" target="_blank" href="https://twitter.com/intent/tweet?url=https://atri-energo.ru/{%FULL_LINK%}" data-tooltip="Twitter">
						<i class="fab fa-twitter" aria-hidden="true"></i>
					</a>
				</li>
				<li class="social-gplus">
					<a class=" tooltip-top" target="_blank" href="viber://forward?text=https://atri-energo.ru/{%FULL_LINK%}" data-tooltip="Viber">
						<i class="fab fa-viber" aria-hidden="true"></i>
					</a>
				</li>	
				<li class="social-gplus">
					<a class=" tooltip-top" target="_blank" href="https://t.me/share/url?url=https://atri-energo.ru/{%FULL_LINK%}" data-tooltip="Telegram">
						<i class="fab fa-telegram-plane" aria-hidden="true"></i>
					</a>
				</li>				
			</ul>
		</div>
	</div>