<div class="item widget-pformat-detail">
					<div class="item-inner widget-post">								
						<div class="widget-thumb">
							<a href="{%FULL_LINK%}">
								<div class="img_over_pos">
									<div class="img_over">
									
										<div class="img_over_shadow">
												<div class="img_overlay"><i class="fa fa-eye" aria-hidden="true"></i></div>
											<picture>
												<source srcset="{%PREVIEW%}" type="image/webp">
												<img src="{%PREVIEW_FULL%}" title="{%TITLE%}" alt="{%TITLE%}" class="cover">
											</picture>		
										</div>
									</div>
								</div>
							</a>
							<div class="entry-content">
								<div class="item-date">
									<div class="date-post">
											<div class="day-post">{%MYDATE:d%}</div>
											<div class="month-post">{%MYDATE:M%}</div>
									</div>
								</div>
								<div class="item-text">
									<h4><a href="{%FULL_LINK%}">{%TITLE:30%}</a></h4>
									<div class="description">
										{%SHORT:100%}				
                                    </div>
								</div>
							</div>
						</div>
                        <div class="item-meta">
								    <div class="readmore"><a href="{%FULL_LINK%}" title="View more" >Подробнее<i class="fa fa-angle-right" aria-hidden="true"></i></a></div>
						</div>
					</div>
				</div>