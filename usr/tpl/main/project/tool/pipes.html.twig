								<label for="CategoryTrees">Тип трубы</label>						
                                <select id="CategoryTrees" class="form-control" aria-describedby="CategoryTrees-help" name="CategoryTrees">
                                    <option value="1" selected>Трубы стальные (газовые) ГОСТ 3262-75</option>
                                    <option value="2">Трубы стальные ГОСТ 10704-91</option>
                                    <option value="3">Трубы чугунные ГОСТ 9583-75 ГОСТ 21053-75</option>
                                    <option value="4">Трубы асбесто - цементные ГОСТ 593-80</option>
                                    <option value="5">Трубы пластмассовые ГОСТ 18599-2001</option>
                                    <option value="6">Трубы железобетонные ГОСТ 12856.0-83</option>
                                    <option value="7">Трубы стекло - пластиковые СП 40-104-2001</option>
                                    <option value="8">Трубы стеклянные ГОСТ 8894-86</option>
                                </select>
								<small id="CategoryTrees-help" class="form-text text-muted">Выверите тип трубы для расчета</small>
							</div> 
