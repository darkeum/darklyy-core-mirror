{% extends "_layout/content_with_sidebar_left.html.twig" %} 

{% block sidebar %}
    {% include 'project/tool/sidebar.html.twig' %} 
{% endblock sidebar %}

{% block breadcrumbs %}
    {% include 'breadcrumbs.html.twig' %} 
{% endblock breadcrumbs %}

{% block title %}
<h1 class="mt-3 h1-page-title">{{ title }}</h1>
{% endblock title %}

{% block content %}
<div class="row mt-3 mb-3">
    <div class="col-12">
        <div class="grid-mn-proect">

            <a href="{{ router('project.tool.pipes') }}" class="grid-mn-proect-a">
                <div class="grid-mn-proect-intem">
                    <div class="grid-mn-proect-intem-text">
                        <h4>Таблица Шевелева</h4>
                        <p>Онлайн инструмент для гидравлического подбора водопроводных труб по таким параметрам как наружный диаметр, толщина стенки и др.</p>
                    </div>
                    <div class="grid-mn-proect-intem-img grid-mn-proect-intem-img-b7"></div>
                </div>
            </a>
            
            <a href="{{ router('project.tool.power') }}" class="grid-mn-proect-a">
                <div class="grid-mn-proect-intem">
                    <div class="grid-mn-proect-intem-text">
                        <h4>Перевод единиц мощности</h4>
                        <p>Онлайн конвертер единиц мощности. Все что вам понадобится это выбрать нужные единицы, ввести значение и увидеть результат.</p>
                    </div>
                    <div class="grid-mn-proect-intem-img grid-mn-proect-intem-img-b8"></div>
                </div>
            </a>        
            
            <a href="{{ router('project.tool.scales') }}" class="grid-mn-proect-a">
            <div class="grid-mn-proect-intem">
                <div class="grid-mn-proect-intem-text">
                    <h4>Калькулятор метизов, крепежа и металлопроката </h4>
                    <p>С помощью данного инструмента вы сможете перевести вес метизов, крепежа и металлопроката в количество</p>
                </div>
                <div class="grid-mn-proect-intem-img grid-mn-proect-intem-img-b9"></div>
            </div>
        </a>      

        </div>
    </div>
</div>
