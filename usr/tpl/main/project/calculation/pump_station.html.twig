{% extends "_layout/content_with_sidebar_left.html.twig" %} 

{% block sidebar %}
    {% include 'project/calculation/sidebar.html.twig' %} 
{% endblock sidebar %}

{% block breadcrumbs %}
    {% include 'breadcrumbs.html.twig' %} 
{% endblock breadcrumbs %}

{% block title %}
<h1 class="mt-3 h1-page-title">{{ title }}</h1>
{% endblock title %}

{% block content %}
<div class="row mt-3 mb-3">
    <div class="col-12">
		<form id="calcForm">
			<div class="card">		
				<div class="card-body">
					<div class="row">
						<div class="col-md-6">
							<div class="form-group">
								<label for="r1">Система установки насосной станции</label>
								<select class="form-control" id="r1" aria-describedby="r1-help" name="r1">
										<option value="1">Повысительный хвс/гвс</option>
										<option value="2">Станция пожаротушения</option>
										<option value="3">Пропиточная система отопления</option>
										<option value="4"> Другое назначение</option>
									</select>
								<small id="r1-help" class="form-text text-muted">Выберите назначение насосной станции</small>
							</div>
							<div class="form-group">
								<label for="rashod">Расход</label>
								<div class="input-group">
  									<input type="text" id="rashod" name="rashod" class="form-control" placeholder="" aria-describedby="rashod-help" required />
									<div class="input-group-append">
										<span class="input-group-text">м3/ч</span>
									</div>
								</div>
								<small id="rashod-help" class="form-text text-muted">Укажите необходимый расход</small>
							</div>
							<div class="form-group">
								<label for="napor">Напор</label>
								<div class="input-group">
									  <input type="text" id="napor" name="napor" class="form-control" placeholder="" aria-describedby="napor-help" required />
									<div class="input-group-append">
										<span class="input-group-text">м.в.ст.</span>
									</div>
								</div>
								<small id="napor-help" class="form-text text-muted">Укажите необходимый напор</small>
							</div>
							<div class="form-group">
								<label for="sum">Количество насосов в станции (включая резервные)</label>
								<select class="form-control" id="sum" name="sum" onchange="kolVoNasosStan(this);">
									<option>2</option>
									<option>3</option>
									<option>4</option>
									<option>5</option>
									<option>6</option>
								</select>
								<small id="sum-help" class="form-text text-muted">Выберите назначение насосной станции</small>
							</div>
							<div class="form-group">
								<label for="sumr">Количество резервных насосов</label>
								<select class="form-control" id="sumr" name="sumr" onchange="kolVoNasosStan(this)">
									<option>0</option>
									<option>1</option>
									<option>2</option>
								</select>
								<small id="sumr-help" class="form-text text-muted">Выберите назначение насосной станции</small>
							</div>
						</div>
						<div class="col-md-6 align-self-end">
							<div class="nasos-div-img">
								<div class="nasos-div-img-dv">
									<div class="nasos-div-img1"></div>
								</div>	
							</div>
						</div>
						<div class="col-md-6">
							<div class="form-group">
								<label for="tocha">На сколько насосов рассчитана рабочая точка?</label>
								<input type="text" class="form-control" name="tocha" id="tocha" aria-describedby="tocha-help" required />
								<small id="tocha-help" class="form-text text-muted">Укажите необходимый напор</small>
							</div>
						</div>
						<div class="col-md-6">
							<div class="form-group">
								<label for="r2">Применение встроенного частотного преобразователя</label>
								<select class="form-control" id="r2" aria-describedby="r2-help" name="r2">
										<option value="1">Насосы со строенным ПЧ</option>
										<option value="2">Шкаф управления с ПЧ</option>
										<option value="3">Шкаф управления "Прямой пуск"</option>
									</select>
								<small id="r2-help" class="form-text text-muted">Выберите назначение насосной станции</small>
							</div>
						</div>
					</div>
					<div class="alert alert-info mt-3" role="alert">
						<h4 class="alert-heading">ПОЛУЧИТЬ РАСЧЁТ ОНЛАЙН</h4>
						   <p>Чтобы получить расчёт насосной станции в режиме онлайн необходимы быть зарегистрированным личном кабинете. При отсутствии регистрации расчет выполняется в течении 1 дня!</p>
						<hr style="margin-top: 1rem; margin-bottom: 1rem;">
						<p class="mb-0">Пройдите в <a href="https://lk.atri-energo.ru/" target="_blank">личный кабинете</a></p>
					</div>
					<div class="mt-3">
					{{ include('project/calculation/contact_form.html.twig', {url: '/project/calculation/send/pump_station'}) }}
					</div>
				</div>
			</div>
		</form>
		<div class="card border-success mb-3 mt-3" id="itsOkHand" style="display: none;">
			<div class="card-body text-success">
				<h5 class="card-title">Расчет отправлен на обработку</h5>
				<p class="card-text" style="line-height: 1.5;">Расчет насосной станции отправлен на обработку нашим специалистам, результаты расчета будут отправлена на указанную электронную почту в течении 1 рабочего дня.</p>
			</div>
		</div>
	</div>
</div>
{% endblock content %}