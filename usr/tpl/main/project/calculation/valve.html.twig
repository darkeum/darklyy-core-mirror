{% extends "_layout/content_with_sidebar_left.html.twig" %} 

{% block sidebar %}
    {% include 'project/calculation/sidebar.html.twig' %} 
{% endblock sidebar %}

{% block breadcrumbs %}
    {% include 'breadcrumbs.html.twig' %} 
{% endblock breadcrumbs %}

{% block title %}
<h1 class="mt-3 h1-page-title">{{ title }}</h1>
{% endblock title %}

{% block content %}
<div class="row mt-3 mb-3">
    <div class="col-12">
		<form id="calcForm">
			<div class="card">		
				<div class="card-body">
					<div class="row">
						<div class="col-md-6">
							<div class="form-group">
								<label for="r1">Выберите способ подбора</label>
								<select class="form-control" id="forType" aria-describedby="r1-help" name="forType">
										<option value="1">По расходу</option>
										<option value="2">По нагрузке</option>
									</select>
								<small id="r1-help" class="form-text text-muted">Считать по нагрузке или по расходу?</small>
							</div>
							<script>
								$('#forType').change(function(){
									if($(this).val() === '1'){
										$('#forFirst').hide();
										$('#forSecond').show();
									} else {
										$('#forFirst').show();
										$('#forSecond').hide();
									}
								});	
							</script>
							<div id="forFirst" style="display: none;">
								<div class="form-group">
									<label for="nagr">Нагрузка</label>
									<div class="input-group">
										<input type="text" id="nagr" name="nagr" class="form-control" placeholder="" aria-describedby="nagr-help"  />
										<div class="input-group-append">
											<span class="input-group-text">бар</span>
										</div>
									</div>
									<small id="nagr-help" class="form-text text-muted">Нагрузка</small>
								</div>
								<div class="row">
									<div class="col-md-6">
										<div class="form-group">
											<label for="t1">T1</label>
											<div class="input-group">
												  <input type="text" id="t1" name="t1" class="form-control" placeholder="" aria-describedby="t1-help"  />
												<div class="input-group-append">
													<span class="input-group-text">°C</span>
												</div>
											</div>
											<small id="t1-help" class="form-text text-muted">Температура в подающем трубопроводе</small>
										</div>
									</div>
									<div class="col-md-6">
										<div class="form-group">
											<label for="t2">T2</label>
											<div class="input-group">
												  <input type="text" id="t2" name="t2" class="form-control" placeholder="" aria-describedby="t2-help"  />
												<div class="input-group-append">
													<span class="input-group-text">°C</span>
												</div>
											</div>
											<small id="t2-help" class="form-text text-muted">Температура в подающем трубопроводе.</small>
										</div>
									</div>
								</div>
							</div>
							<div id="forSecond">
								<div class="form-group">
									<label for="q">Расход сетевого теплоносителя. </label>
									<div class="input-group">
										<input type="text" id="q" name="q" class="form-control" placeholder="" aria-describedby="q-help"  />
										<div class="input-group-append">
											<span class="input-group-text">м³/ч</span>
										</div>
									</div>
									<small id="q-help" class="form-text text-muted">Расход сетевого теплоносителя. </small>
								</div>
								<div class="form-group">
									<label for="p1">Давление перед клапаном</label>
									<div class="input-group">
										<input type="text" id="p1" name="p1" class="form-control" placeholder="" aria-describedby="p1-help"  />
										<div class="input-group-append">
											<span class="input-group-text">бар</span>
										</div>
									</div>
									<small id="p1-help" class="form-text text-muted">Давление перед клапаном</small>
								</div>
							</div>							
						</div>
						<div class="col-md-6 text-center">
							<img src="/usr/tpl/main/resources/images/project/vrdd.jpg" class="center-block img-responsive" style="margin: 0 auto; height: 250px; width: auto;"/>						
						</div>
						<div class="col-md-4">
							<div class="form-group">
								<label for="p2">Давление после клапана</label>
								<div class="input-group">
									<input type="text" id="p2" name="p2" class="form-control" placeholder="" aria-describedby="p2-help" required />
									<div class="input-group-append">
										<span class="input-group-text">бар</span>
									</div>
								</div>
								<small id="p2-help" class="form-text text-muted">Давление после клапана	</small>
							</div>
						</div>
						<div class="col-md-4">
							<div class="form-group">
								<label for="tmax">Максимальная температура среды</label>
								<div class="input-group">
									<input type="text" id="tmax" name="tmax" class="form-control" placeholder="" aria-describedby="tmax-help" required />
									<div class="input-group-append">
										<span class="input-group-text">°C</span>
									</div>
								</div>
								<small id="tmax-help" class="form-text text-muted">Максимальная температура среды</small>
							</div>
						</div>
						<div class="col-md-4">
							<div class="form-group">
								<label for="pressure_drop">Расчетный перепад</label>
								<div class="input-group">
									<input type="text" id="pressure_drop" name="pressure_drop" class="form-control" placeholder="" aria-describedby="pressure_drop-help" required />
									<div class="input-group-append">
										<span class="input-group-text">°C</span>
									</div>
								</div>
								<small id="pressure_drop-help" class="form-text text-muted">Расчетный перепад на полностью открытом клапане</small>
							</div>
						</div>
					</div>
					<div class="mt-3">
						{{ include('project/calculation/contact_form.html.twig', {url: '/project/calculation/send/valve'}) }}
					</div>
				</div>
			</div>
		</form>
		<div class="card border-success mb-3 mt-3" id="itsOkHand" style="display: none;">
			<div class="card-body text-success">
				<h5 class="card-title">Расчет отправлен на обработку</h5>
				<p class="card-text" style="line-height: 1.5;">Расчет регулирующего клапана отправлен на обработку нашим специалистам, результаты расчета будут отправлена на указанную электронную почту в течении 1 рабочего дня.</p>
			</div>
		</div>
	</div>
</div>
{% endblock content %}