<div class="row">
    <div class="col-md-8">
        <div class="block_cont_name">Организация</div>
        <input type="text" id="t_organizaciya" name="org_name" placeholder="Укажите наименование или ИНН организации" class="block_cont_field">
        <link href="{{ theme }}/assest/vendor/suggestions/suggestions.css" rel="stylesheet" />
        <script src="{{ theme }}/assest/vendor/suggestions/jquery.suggestions.min.js"></script>
        <script>
            $("#t_organizaciya").suggestions({
                token: "ddeafb9ff43e79578243d8f031f6e9d8b047ca0e",
                type: "PARTY",
                /* Вызывается, когда пользователь выбирает одну из подсказок */
                onSelect: function(suggestion) {
                    console.log(suggestion);
                    $("#t_inn").val(suggestion.data.inn);
                }
            });
        </script>
        <style>
            .suggestions-wrapper {
                top: -16px;
            }
            
            .suggestions-suggestions {
                min-width: 101% !important;
            }
        </style>
        <input type="hidden" id="t_inn" name="org_inn" />
    </div>
    <div class="col-md-4">
        <div class="block_cont_name">Объект</div>
        <input type="text" name="object_name" placeholder="Укажите объект" required class="block_cont_field">
    </div>
    <div class="col-md-4">
        <div class="block_cont_name">Ваше ФИО</div>
        <input type="text" name="name" placeholder="Укажите ваше ФИО" required class="block_cont_field">
    </div>
    <div class="col-md-4">
        <div class="block_cont_name">Ваш E-mail</div>
        <input type="email" name="email" placeholder="Укажите ваш E-mail" required class="block_cont_field">
    </div>
    <div class="col-md-4">
        <div class="block_cont_name">Ваш номер телефона</div>
        <input type="text" name="phone" placeholder="Укажите ваш номер телефона" required class="block_cont_field">
    </div>
    <div class="col-md-12">
        <div class="block_cont w66">
            <div class="block_cont_name">Примечание</div>
            <textarea class="block_cont_field" name="message"></textarea>
        </div>
    </div>
    <input type="hidden" name="g-recaptcha-response" id="recaptchaResponse" />
    {% if btn is not defined %}
    <div class="col-md-12">
        <div class="block_cont">
            <button id="btnFetch" class="cmt-btn cmt-btn-size-md cmt-btn-shape-round cmt-btn-style-border cmt-btn-color-skincolor" type="submit">Отправить</button>
        </div>
    </div>
    {% else %}{{ btn }}{% endif %}
</div>
<script src="https://www.google.com/recaptcha/api.js?render=6LfddtUZAAAAAELCRiYyqMJSTIeYCNHvU7E5_xbP"></script>
<script>
    $('#calcForm').on("submit", function(e) {
        const form = this;
        e.preventDefault();
        $("#btnFetch").prop("disabled", true);

        $("#btnFetch").html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Отправка...');
        grecaptcha.ready(function() {
            grecaptcha.execute('6LfddtUZAAAAAELCRiYyqMJSTIeYCNHvU7E5_xbP', {
                action: 'contact'
            }).then(async function(token) {
                var recaptchaResponse = document.getElementById('recaptchaResponse');
                recaptchaResponse.value = token;
                try {
                    var sub = '{}';
                    if (typeof (prepareData) === "function") {
                        sub = prepareData();
                    }
                    const data = new FormData(form);
                    data.append('sub', sub);
                    const _response = await (await fetch(`{% if url is not defined %}/project/calculation/send/heat{% else %}{{ url }}{% endif %}`, {
                        method: "POST",
                        body:  data                        
                    })).json();
                    var type = _response.type;
                    var error = _response.error;
                    var errorMessage = '';
                    var success = _response.success;
                    if (type == "error") {
                        for (var k in error) {
                            errorMessage = errorMessage + error[k] + '<br>';
                            console.log(errorMessage);
                        }
                        Swal.fire('Ошибка', errorMessage, 'error');
                        $("#btnFetch").prop("disabled", false);
                        $("#btnFetch").html('Отправить');
                    } else if(type == "calc") {
                        Swal.fire({
                          icon: 'success',
                          title: 'Расчет готов',
                          showCancelButton: true,
                          text: 'Расчет узла учета готов, вы можете скачать проект по кнопке ниже',
                          confirmButtonText: 'Скачать',
                          cancelButtonText: 'Закрыть',                           
                        }).then((result) => {
                            if (result?.value) {
                                window.open(_response.zip, '_blank');
                            } 
                          })
                        $("#btnFetch").prop("disabled", false);
                        $("#btnFetch").html('Отправить');
                    }
                    else {
                        Swal.fire('Информация', success, 'success');
                        $('#btnFetch').remove();
                        $('#calcForm').remove();
                        $('#itsOkHand').show();
                        $('#feedbackSend').html('<div class="alert alert-success alert-lg w-100 mt-3"><h4 class="no-margin no-padding">Информация</h4><p>' + success + '</p></div>');
                    }
                } catch (e) {
                    const error = e.message;
                    $("#btnFetch").prop("disabled", false);
                    $("#btnFetch").html('Отправить');
                    Swal.fire('Ошибка', error, 'error');
                }
            });
        });

    });
</script>