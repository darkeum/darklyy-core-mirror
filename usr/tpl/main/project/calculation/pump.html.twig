{% extends "_layout/content_with_sidebar_left.html.twig" %} 

{% block sidebar %}
    {% include 'project/calculation/sidebar.html.twig' %} 
{% endblock sidebar %}

{% block breadcrumbs %}
    {% include 'breadcrumbs.html.twig' %} 
{% endblock breadcrumbs %}

{% block title %}
<h1 class="mt-3 h1-page-title">{{ title }}</h1>
{% endblock title %}

{% block content %}
<div class="row">
    <div class="col-12">
        <form id="calcForm">
			<div class="ns_podbor_dv">
				<div class="ns_podbor">
					<div class="ns_podbor_b1" style="padding-top: 25px;">
						<div class="block_cont">
							<div class="block_cont_name">Напор (H)</div> 
							<input type="text" name="pressure" id="pressure" required="required" placeholder="Введите напор" class="block_cont_field block_cont_field_i1">
						</div>
						<div class="block_cont ns_block_cont" style="    margin-top: 66px;">
							<div class="block_cont_name">Расход (G)</div> 
							<input type="text" name="qPump" id="qPump" required="required" placeholder="Введите расход" class="block_cont_field block_cont_field_i2" style="height: 38.9px;  margin-top: -0.02px; width: 163px !important;">
						</div>
					</div>
					<div class="ns_podbor_b2">
						<div class="ns_podbor_tm1">
							<div class="arrow-6 arrow-7">
								<span></span>
								<span></span>
								<span></span>
							</div>
						</div>
						<div class="ns_podbor_tm2">
							<div class="arrow-4 arrow-7">
								<span></span>
								<span></span>
								<span></span>
							</div>
						</div>
						<div class="ns_podbor_t1">
							<div class="ns_podbor_l1"></div>
							<div class="ns_podbor_l2"></div>
							<div class="ns_podbor_l3"></div>
						</div>
						<div class="ns_podbor_t2"></div>
						
					</div>
					<div class="ns_podbor_b3">
						<div class="block_cont"><div class="block_cont_name">Назначение насосного оборудования</div>
							<select class="block_cont_field" name="type" id="type">
								<option value="1">Отопление</option>
								<option value="2">Циркуляция ГВС</option>
								<option value="3">Подпитка отопления</option>
								<option value="4">Повысительный хвс/гвс</option>
								<option value="5">Пожарные насосы</option>
							</select>
						</div>
						<div class="block_cont"><div class="block_cont_name">Частотный преобразователь</div>
							<label class="form-check-label mt-2">
								<input style="margin-top: 2px;" class="form-check-input ml-1" name="r1" value="1" type="radio" checked="checked"><span class="pl-25">Применить ПЧ</span>
							</label>
							
							<label class="form-check-label mt-2">
								<input style="margin-top: 2px;" class="form-check-input ml-1" name="r1" value="2" type="radio"><span class="pl-25">Без ПЧ</span>
							</label>
						</div>
						<div class="block_cont"><div class="block_cont_name">Напряжение</div>
							<label class="form-check-label mt-2">
								<input style="margin-top: 2px;" class="form-check-input ml-1" name="r2" value="1" type="radio" checked="checked">
								<span class="pl-25"><i class="fa fa-bolt text-warning" aria-hidden="true"></i> 220</span>
							</label>
							
							<label class="form-check-label mt-2">
								<input style="margin-top: 2px;" class="form-check-input ml-1" name="r2" value="2" type="radio">
								<span class="pl-25"><i class="fa fa-bolt text-warning" aria-hidden="true"></i> 380</span>
							</label>
						</div>
					</div>
				</div>
                <div class="alert alert-info mt-3" role="alert">
            		<h4 class="alert-heading">ПОЛУЧИТЬ РАСЧЁТ ОНЛАЙН</h4>
           			<p>Чтобы получить расчёт насосного оборудования в режиме онлайн необходимы быть зарегистрированным личном кабинете. При отсутствии регистрации расчет выполняется в течении 1 дня!</p>
            		<hr style="margin-top: 1rem; margin-bottom: 1rem;">
            		<p class="mb-0">Пройдите в <a href="https://lk.atri-energo.ru/" target="_blank">личный кабинете</a></p>
        		</div>
				<div class="teplo-grid-bt mt-3">
					{{ include('project/calculation/contact_form.html.twig', {url: '/project/calculation/send/pump'}) }}
				</div>								
			</div>
		</form>
		<div class="card border-success mb-3 mt-3" id="itsOkHand" style="display: none;">
			<div class="card-body text-success">
				<h5 class="card-title">Расчет отправлен на обработку</h5>
				<p class="card-text" style="line-height: 1.5;">Расчет насосного оборудования отправлены на обработку нашим специалистам, результаты расчета будут отправлена на указанную электронную почту в течении 1 рабочего дня.</p>
			</div>
		</div>
        <div class="teplo-txt">
            <h3>ПОДБОР НАСОСНОГО ОБОРУДОВАНИЯ</h3>
            <span class="teplo-span">Предлагаем Вам воспользоваться услугой подбора насосного оборудования Wilo через предложенную форму запроса.</span>
            <div class="teplo-hr"></div>
            <div class="nasos-txt-img">
                <p class="nasos_p_top"><strong>Вы получите:</strong></p>							
                <ul class="nasos_list">
                    <li>Качественный подбор насосного оборудования, обеспечивающего стабильную работу под Вашу систему в течение 2-х часов.</li><br>
                    <li>Лист подбора насосного оборудования.</li><br>
                    <li>Коммерческое предложение от официального дилера.</li>
				</ul>
			</div>
		</div>
    </div>
</div>
{% endblock content %}