    function chooseStep($step) {
        var sbThis = $('.block-form .sf-active');
        var sbNext = $('#' + $step);
        if (sbNext.length) {
            if (sbNext.hasClass('shag-sf-true')) {
                $('#' + sbThis.data('headtab')).removeClass('shag-active');
                sbThis.removeClass('sf-active');
                sbNext.addClass('sf-active');
                $('.block-form .shag-content').hide();
                sbNext.show();
                $('#' + sbNext.data('headtab')).addClass('shag-active');
                $('.modal-form-bot-right').css('display', 'inline-block');
                $('.modal-form-bot-left').css('display', 'inline-block');
                if ($('.block-form .sf-active').hasClass('sf-first')) {
                    $('.block-form .modal-form-bot-left').css('display', 'none');
                } else {
                    $('.modal-form-bot-right').css('display', 'inline-block');
                    $('.block-form .modal-form-bot-save').css('display', 'none');
                }
                if ($('.block-form .sf-active').hasClass('sf-last')) {
                    $('.block-form .modal-form-bot-right').css('display', 'none');
                    $('.block-form .modal-form-bot-save').css('display', 'inline-block');
                } else {
                    $('.modal-form-bot-right').css('display', 'inline-block');
                    $('.block-form .modal-form-bot-save').css('display', 'none');
                }
            }
        }
    }

    function sbPrev() {
        var sbThis = $('.block-form .sf-active');
        var sbNext = $('.block-form .sf-active').prevAll('.shag-sf-true').eq(0);
        if (sbNext.length) {
            $('#' + sbThis.data('headtab')).removeClass('shag-active');
            sbThis.removeClass('sf-active');
            sbNext.addClass('sf-active');
            $('.block-form .shag-content').hide();
            sbNext.show();
            $('#' + sbNext.data('headtab')).addClass('shag-active');
            if ($('.block-form .sf-active').hasClass('sf-first')) {
                $('.block-form .modal-form-bot-left').css('display', 'none');
            } else {
                $('.modal-form-bot-right').css('display', 'inline-block');
                $('.block-form .modal-form-bot-save').css('display', 'none');
            }
        }
    }

    function sbNext() {
        var sbThis = $('.block-form .sf-active');
