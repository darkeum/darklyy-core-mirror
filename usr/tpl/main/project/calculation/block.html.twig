    function change_gvs_type_sel_gvs(t) {
        const item = $(t);
        const value = item.val();
        const reg_t_sel = item.parent().parent().find("#reg_t_sel");
        switch (value) {
            default:
                case "1":
                reg_t_sel.val("1").change().prop("disabled", true);
            break;
            case "2":
                    reg_t_sel.prop("disabled", false);
                break;
        }
