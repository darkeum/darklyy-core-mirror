{% extends "_layout/content_with_sidebar_left.html.twig" %} 

{% block sidebar %}
    {% include 'project/sidebar.html.twig' %}
{% endblock sidebar %}

{% block breadcrumbs %}
    {% include 'breadcrumbs.html.twig' %}
{% endblock breadcrumbs %}

{% block title %}
    <h1 class="mt-3 h1-page-title">{{ title }}</h1>
{% endblock title %}

{% block content %}
    <div class="cmt-bgcolor-white box-shadow pt-10 pl-30 pb-40 pr-30 mt-3 mb-3">
        <div class="row">
            <div class="col-12 mt-3 mb-3">
                <div class="section-title">
                    <div class="title-header">
                        <h5>проектный отдел</h5>
                        <h2 class="title"><strong>комплексное проектирование</strong></h2>
                    </div>
                    <div class="title-desc">Компания ООО «АТРИ-ЭНЕРГО» - предоставляет комплексное проектирование
                        которое включает в себя весь спектр работ по проектированию ИТП, ЦТП, насосной, систем
                        отопления, водоснабжения и водоотведения.
                    </div>
                </div>
            </div>
            <div class="col-md-12">
                <h3 class="h2">Комплексное проектирование включает в себя следующие этапы:</h3>
                <div class="row">
                    <div class="col-md-3 mb-35">
                        <!-- Element-article start -->
                        <div class="e-article wow-delay wow fadeInUp  animated animated" style="visibility: visible;">
                            <div class="wow fadeInUp cn-mb-15 animated animated" data-wow-delay="0.1s"
                                 style="visibility: visible; animation-delay: 0.1s;">
                                <a class="elem-img-hover img-round cn-d-bl" href="#p1"><img class="img-round cn-wp-100"
                                                                                            src="/usr/tpl/main/resources/images/project/p1.png"
                                                                                            alt=""></a>
                            </div>
                            <a class="color__jacksons-purple typo-ondem" href="#p1">1 этап <br>Предпроектная подготовка</a>
                        </div>
                        <!-- Element-article end -->
                    </div>
                    <div class="col-md-3 mb-35">
                        <!-- Element-article start -->
                        <div class="e-article wow-delay wow fadeInUp  animated animated" style="visibility: visible;">
                            <div class="wow fadeInUp cn-mb-15 animated animated" data-wow-delay="0.1s"
                                 style="visibility: visible; animation-delay: 0.1s;">
                                <a class="elem-img-hover img-round cn-d-bl" href="#p2"><img class="img-round cn-wp-100"
                                                                                            src="/usr/tpl/main/resources/images/project/p2.png"
                                                                                            alt=""></a>
                            </div>
                            <a class="color__jacksons-purple typo-ondem" href="#p2">2 этап <br>Разработка проектной
                                документации</a>
                        </div>
                        <!-- Element-article end -->
                    </div>
                    <div class="col-md-3 mb-35">
                        <!-- Element-article start -->
                        <div class="e-article wow-delay wow fadeInUp  animated animated" style="visibility: visible;">
                            <div class="wow fadeInUp cn-mb-15 animated animated" data-wow-delay="0.1s"
                                 style="visibility: visible; animation-delay: 0.1s;">
                                <a class="elem-img-hover img-round cn-d-bl" href="#p3"><img class="img-round cn-wp-100"
                                                                                            src="/usr/tpl/main/resources/images/project/p3.png"
                                                                                            alt=""></a>
                            </div>
                            <a class="color__jacksons-purple typo-ondem" href="#p3">3 этап <br>Согласование проектной
                                документации</a>
                        </div>
                        <!-- Element-article end -->
                    </div>
                    <div class="col-md-3 mb-35">
                        <!-- Element-article start -->
                        <div class="e-article wow-delay wow fadeInUp  animated animated" style="visibility: visible;">
                            <div class="wow fadeInUp cn-mb-15 animated animated" data-wow-delay="0.1s"
                                 style="visibility: visible; animation-delay: 0.1s;">
                                <a class="elem-img-hover img-round cn-d-bl" href="#p4"><img class="img-round cn-wp-100"
                                                                                            src="/usr/tpl/main/resources/images/project/p4.png"
                                                                                            alt=""></a>
                            </div>
                            <a class="color__jacksons-purple typo-ondem" href="#p4">4 этап <br>Авторский надзор</a>
                        </div>
                        <!-- Element-article end -->
                    </div>
                </div>
            </div>
            <div id="p1" class="col-md-12">
                <h3 class="h2"><strong>1 Этап</strong> - Предпроектная подготовка:</h3>
                <p style="line-height: 1.5;">Предпроектная подготовка это важный этап на котором собираются все
                    необходимы сведения для проектирования объекта, получаются технические условия и разрабатывается
                    техническое задание</p>
                <p style="line-height: 1.5;"><strong>Перед разработкой проекта необходимо:</strong></p>
                <ul class="cmt-list cmt-list-style-icon cmt-list-icon-color-skincolor mt-20 mb-20">
                    <li><i class="cmt-textcolor-skincolor far fa-check-circle"></i><span class="cmt-list-li-content">Получить технические Условия подключения к сетям теплоснабжения, водоснабжения и водоотведения</span>
                    </li>
                    <li><i class="cmt-textcolor-skincolor far fa-check-circle"></i><span class="cmt-list-li-content">Составить техническое задание на проектирование</span>
                    </li>
                    <li><i class="cmt-textcolor-skincolor far fa-check-circle"></i><span class="cmt-list-li-content">Заполнить и отправить заявку на проектирование</span>
                    </li>
                </ul>
                <a class="cmt-btn cmt-btn-size-md cmt-btn-shape-round cmt-btn-style-border cmt-btn-color-skincolor mb-3"
                   href="{{ router('project.order') }}">Отправить заявку на проектирование</a>
                <p style="line-height: 1.5;">В зависимости от поставленных задач, основание для проектирования
                    уточняется. Возможно воспользоваться выездом технического специалиста для определения необходимых
                    параметров для составления технического задания, заявления на получение ТУ и т.д. Проект
                    изготавливается в двух и более экземплярах, если это необходимо для согласования.</p>
            </div>
            <div id="p2" class="col-md-12">
                <h3 class="h2"><strong>2 Этап</strong> - Разработка проектной документации:</h3>
                <p style="line-height: 1.5;" class="mb-2 mt-2"><strong>Производится полный комплекс работ по разработке
                        проектной документации:</strong></p>
                <p style="line-height: 1.5;">Проектирование Индивидуальных тепловых пунктов (<b>ИТП</b>), Центральных
                    тепловых пунктов (<b>ЦТП</b>), повысительных насосных станций (<b>ПВНС</b>), систем отопелния,
                    водоснабжения и водоотведения осуществляется по техническому заданию Заказчика, с проведением
                    всестороннего обследования объекта, с уточнением всех параметров, требуемых для разработки
                    принципиальных схем и подбора оборудования. </p>
                <p style="line-height: 1.5;">Оптимальность выбора оборудования <b>гарантирована</b> за счет применения
                    <b>специальных компьютерных программ</b> и высокого уровня квалификации специалистов. </p>
                <p style="line-height: 1.5;">Разработка осуществляется с учетом конструктивных особенностей помещений и
                    возможности присоединения к существующим сетям. Проектирование выполняется по разделам.</p>
                <p style="line-height: 1.5;" class="mb-2 mt-2"><strong>При разработке проектной документации мы
                        учитываем:</strong></p>
                <ul class="cmt-list cmt-list-style-icon cmt-list-icon-color-skincolor mt-20 mb-20">
                    <li><i class="cmt-textcolor-skincolor far fa-check-circle"></i><span class="cmt-list-li-content">Пожелания Заказчика по типу оборудования и уровню автоматизации ИТП, ЦТП, насосной, систем отопления и водоснабжения.</span>
                    </li>
                    <li><i class="cmt-textcolor-skincolor far fa-check-circle"></i><span class="cmt-list-li-content">Требования теплоснабжающих, водоснабжающей организаций к Проекту, исходя из большого опыта  проектирования, согласования и строительства.</span>
                    </li>
                    <li><i class="cmt-textcolor-skincolor far fa-check-circle"></i><span class="cmt-list-li-content">Возможности оптимизации Проекта путем подбора надежного оборудования и материалов по оптимальным ценам.</span>
                    </li>
                </ul>
            </div>
            <div id="p3" class="col-md-12">
                <h3 class="h2"><strong>3 Этап</strong> - Согласование проектной документации:</h3>
                <p style="line-height: 1.5;"><strong>Производится согласование проектной документации во всех
                        необходимых инстанциях:</strong></p>
                <ul class="cmt-list cmt-list-style-icon cmt-list-icon-color-skincolor mt-20 mb-20">
                    <li><i class="cmt-textcolor-skincolor far fa-check-circle"></i><span class="cmt-list-li-content">C заказчиком;</span>
                    </li>
                    <li><i class="cmt-textcolor-skincolor far fa-check-circle"></i><span class="cmt-list-li-content">В теплоснабжающей, водоснабжающей организации;</span>
                    </li>
                    <li><i class="cmt-textcolor-skincolor far fa-check-circle"></i><span class="cmt-list-li-content">В органах Ростехнадзора (при необходимости).</span>
                    </li>
                </ul>
                <p style="line-height: 1.5;">Итогом  работы является пакет Проектной документации, выполненный согласно
                    всем действующим нормам и правилам, согласованный во всех необходимых инстанциях и  готовый для
                    передачи в производство.</p>
            </div>
            <div id="p4" class="col-md-12">
                <h3 class="h2"><strong>4 Этап</strong> - Авторский надзор:</h3>
                <p style="line-height: 1.5;">Производится контроль за соблюдением в процессе строительства требований
                    проектной документации, разработанной ранее проектным отделом АтриЭнерго.</p>
            </div>
        </div>
    </div>
    <style>
        .cmt-list.cmt-list-style-icon li i {
            position: absolute;
            left: auto;
            top: 0px;
            font-weight: 700;
        }

        .ash2, .h2 {
            font-size: 17px;
            font-family: Verdana, sans-serif;
            color: #fa381d;
            padding: 0;
            padding-left: 10px;
            vertical-align: middle;
            border-left: 2px solid #fa381d;
            margin-bottom: 15px;
            line-height: 150%;
            margin-top: 10px;
            display: block;
            font-style: normal;
        }

        a:hover {
            text-decoration: none !important;
        }

        .input-text {
            height: 40px;
            border: 1px solid #ddd;
            font-size: 13px;
            color: #555;
            padding: 0 20px;
            width: 100%;
        }

        label {
            display: inline-block;
            margin: 0;
        }

        textarea:focus, input:focus, select:focus {
            border-color: #ddd !important;
        }

        textarea.input-text {
            height: 105px;
            font-size: 13px;
            line-height: 1.2;
            margin: 5px 0 0;
            padding-top: 15px;
        }

        .toggle {
            margin: 0 0 1.5rem;
            box-sizing: border-box;
            font-size: 0;
            display: flex;
            flex-flow: row nowrap;
            justify-content: flex-end;
            align-items: stretch;
            font-size: 15px;
        }

        .cn-wp-100 {
            width: 100%;
        }

        .img-fit-contain {
            -o-object-fit: contain;
            object-fit: contain
        }

        .img-fit-cover {
            -o-object-fit: cover;
            object-fit: cover
        }

        .img-fit-full {
            -o-object-fit: unset;
            object-fit: unset
        }

        .img-round {
            -webkit-border-radius: 25px;
            -moz-border-radius: 25px;
            border-radius: 25px
        }

        .color__jacksons-purple {
            color: #1e3b87;
        }

        .typo-ondem {
            font-size: 0.88em;
            font-weight: 600;
        }

        .cn-d-bl {
            display: block !important;
        }


        .elem-img-hover {
            position: relative;
            overflow: hidden
        }

        .elem-img-hover:before {
            content: '';
            display: block;
            position: absolute;
            left: 0;
            bottom: 0;
            right: 0;
            top: 0;
            z-index: 1;
            background-image: url(/usr/tpl/main/resources/images/icon/eye.svg);
            -webkit-background-size: 2.50em 2.50em;
            -moz-background-size: 2.50em;
            -o-background-size: 2.50em;
            background-size: 2.50em;
            background-repeat: no-repeat;
            background-position: 50% 50%;
            opacity: 0;
            -webkit-transition: all 240ms;
            -o-transition: all 240ms;
            -moz-transition: all 240ms;
            transition: all 240ms
        }

        .elem-img-hover:after {
            content: '';
            display: block;
            position: absolute;
            background-color: #fa381d;
            -webkit-border-radius: 50px;
            -moz-border-radius: 50px;
            border-radius: 50px;
            width: 6em;
            height: 6em;
            left: 50%;
            top: 50%;
            -webkit-transition: all 400ms;
            -o-transition: all 400ms;
            -moz-transition: all 400ms;
            transition: all 400ms;
            opacity: 0;
            margin-left: -2.5em;
            margin-top: -2.5em
        }

        .elem-img-hover:hover:after {
            opacity: 0.69;
            -webkit-transform: scaleX(4) scaleY(4);
            -moz-transform: scaleX(4) scaleY(4);
            -ms-transform: scaleX(4) scaleY(4);
            -o-transform: scaleX(4) scaleY(4);
            transform: scaleX(4) scaleY(4)
        }

        .elem-img-hover:hover:before {
            opacity: 1
        }

        .elem-img-hover:hover {
            -webkit-transform: scaleX(1.06) scaleY(1.05);
            -moz-transform: scaleX(1.06) scaleY(1.05);
            -ms-transform: scaleX(1.06) scaleY(1.05);
            -o-transform: scaleX(1.06) scaleY(1.05);
            transform: scaleX(1.06) scaleY(1.05)
        }

    </style>
{% endblock content %}