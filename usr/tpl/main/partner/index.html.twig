{% extends "_layout/content_with_sidebar_left.html.twig" %}

{% block sidebar %}
    <div class="block widget-recent spaceBlock news-left-block">
        <div class="block-content news-left-block-content">
            {{ categories('partner', 'Все партнёры') }}
        </div>
    </div>  
    <div class="widget-area mt_15 mb-3">
        {% include '_widget/widget_callback_left.html.twig' %}
    </div>
    {% include '/partner/form.html.twig' %}
{% endblock sidebar %}

{% block breadcrumbs %}
    {% include 'breadcrumbs.html.twig' %}
{% endblock breadcrumbs %}

{% block title %}
    <h1 class="mt-3 h1-page-title">{{ title }}</h1>		
{% endblock title %}

{% block content %}                    
<div class="row mt-3">
    {% if items is empty %}   
    <div class="col-md-12 mb-3">
        <div class="alert alert-warning alert-lg w-100 mt-3" role="alert">
            <h4 class="no-margin no-padding">Информация</h4>	
            <p>К сожалению по данному запросу партнеров не найдено, попробуйте зайти позже!</p>	
        </div>
    </div>
    {% else %}
    <div class="col-md-12">
        <div class="row wrap-partner"> 
            {% for item in items %}
                <div class="col-md-4 mb-3">
                    <div class="f-category">
                        <div class="img-div-responsive"><img src="{{ item.preview.full }}" class="img-responsive" alt="img"></div>
                        <h2>{{ item.title }}</h2>
                        <p>{{ item.description|truncate_words(200) }}</p>
                        <div class="partner-bot">
                            <div class="partner-bot-div"><a href="{{ item.url }}">Подробнее</a><i onclick="window.open('{{ item.site_url }}');" class="far fa-link" aria-hidden="true"></i></div>
                        </div>
                    </div>
                </div> 
            {% endfor %}  
        </div>  
    </div>    
    <div class="col-12 mt-3">
        {{ items.links|raw }}
    </div>   
    {% endif %}
</div>
<style>
.wrap-partner .f-category {
    background: #fff;
    border: 1px solid #ddd;
    border-radius: 4px;
    height: 350px;
    justify-content: end;
    vertical-align: bottom;
    display: table-cell;
}
.partner-bot-div a {
    padding: 12px 25px!important;
    margin: 5px 0 10px 15px!important;
    border-radius: 25px 0 0 25px;
    background: #444;
    color: #fff;
    text-decoration: none;
    display: inline-block;
    font-size: 14px;
    height: 42px;
}
.partner-bot-div .fa-link {
    background: #444;
    border-left: 1px solid #222;
    display: inline-block;
    color: #fff;
    border-radius: 0 25px 25px 0;
    padding: 0px 20px 0px 15px!important;
    margin: 0;
    line-height: 42px;
    font-size: 16px;
    position: relative;
    top: 3px;
}
.h2 {
    font-size: 17px;
    font-family: Verdana, sans-serif;
    color: #FA381D;
    padding: 0;
    padding-left: 10px;
    vertical-align: middle;
    border-left: 2px solid #FA381D;
    margin-bottom: 15px;
    line-height: 150%;
    margin-top: 10px;
    display: block;	
    font-style: normal;
}

.ah2:hover {
    text-decoration: none;	
}
a:hover {
    text-decoration: none !important;
}

img.img_left {
    display: block;
    float: right;
    margin-right: 15px;
    margin-bottom: 10px;
    padding: 3px;
    border: 1px solid #E2E3E5 !important;
    max-width: 214px !important;
}	
</style>   
{% endblock content %}