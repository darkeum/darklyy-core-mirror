{% extends "_layout/content_with_sidebar_left.html.twig" %}

{% block sidebar %}
    <div class="block widget-recent spaceBlock news-left-block">
        <div class="block-content news-left-block-content">
            {{ categories('job', 'Все вакансии') }}
        </div>
    </div>
    <div class="widget-area mt_15 mb-3">
        {% include '_widget/widget_callback_left.html.twig' %}
    </div>
{% endblock sidebar %}

{% block title %}
    <h1 class="mt-3 h1-page-title">
        {{ title }}
    </h1>
{% endblock title %}

{% block breadcrumbs %}
    <ul id="breadcrumbs-two" class="breadcrumb">
    {% for bread in breadcrumbs %}       
        {% if loop.last %}
            <li class="active"><span>{{ bread.name }}</span></li>
        {% else %}
            <li><a href="{{ bread.url }}"> {{ bread.name }}</a></li>
        {% endif %}       
    {% endfor %}
    </ul>
{% endblock breadcrumbs %}

{% block content %}
    {% include 'job/form.html.twig' %}
{% endblock content %}