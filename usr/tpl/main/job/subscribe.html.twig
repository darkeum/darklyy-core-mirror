{% extends "_layout/content_with_sidebar_left.html.twig" %}

{% block sidebar %}
    <div class="block widget-recent spaceBlock news-left-block">
        <div class="block-content news-left-block-content">
            {{ categories('job', 'Все вакансии') }}
        </div>
    </div>
    <div class="widget-area mt_15 mb-3">
        {% include '_widget/widget_callback_left.html.twig' %}
    </div>
{% endblock sidebar %}

{% block title %}
    <h1 class="mt-3 h1-page-title">
        {{ title }}
    </h1>
{% endblock title %}

{% block breadcrumbs %}
    <ul id="breadcrumbs-two" class="breadcrumb">
    {% for bread in breadcrumbs %}       
        {% if loop.last %}
            <li class="active"><span>{{ bread.name }}</span></li>
        {% else %}
            <li><a href="{{ bread.url }}"> {{ bread.name }}</a></li>
        {% endif %}       
    {% endfor %}
    </ul>
{% endblock breadcrumbs %}

{% block content %}
    <style>
        .input-text {
            height: 40px;
            border: 1px solid #ddd;
            font-size: 13px;
            color: #555;
            padding: 0 20px;
            margin-bottom: 20px;
            width: 100%;
        }
        label {
            display: inline-block;
            margin: 0;
        }
        textarea:focus, input:focus, select:focus {
    border-color: #ddd !important;
}
    </style>
    <div class="row">
        <div class="col-12 mt-3 mb-3">
            <div class="section-title">
                <div class="title-header">
                    <h5>Будь в курсе изменений</h5>
                    <h2 class="title">Заполните  <strong>форму</strong></h2>
                </div>
            </div>
            <div class="card">		
                <div class="card-body card-body-cert">	
                    <div class="pt-15 pb-15 pr-30 mb_30 res-991-pr-0 res-991-pt-30">  
                        <p>Подпишитесь на публикацию новых вакансий в нашей компании и вы всегда будете вкурсе открытых должностей и сможете претендовать на них!</p>
                        <form id="jobSubscribe" >
                            <div class="row">
                                <div class="col-3 mt-3">
                                    Электронная почта: *
                                </div>
                               <div class="col-9 mt-3">
                                    <input type="text" name="email" id="email"  class="input-text" placeholder="Укажите ваш E-mail адрес*" required="required" />
                                </div> 											
                            </div>
                            <div class="row">
                                <div class="col-3 mt-3">
                                    Выберите рубрику: *
                                </div>
                                <div class="col-9 mt-3">  
                                    <div>
                                        <input type="checkbox" id="all" name="all" />
                                        <label for="all">Все</label>
                                    </div>
                                    {% for cat in categories %}  
                                    <div>
                                        <label>
                                        <input type="checkbox" id="cat_{{ cat.id }}" name="cat[{{ cat.id }}]" />
                                        {{ cat.name }}</label>
                                    </div>
                                    {% endfor %}  
                                    <div>
                                        <input type="checkbox" id="other" name="other" />
                                        <label for="other">Другие вакансии</label>   
                                    </div>                 
                                </div> 			                   							
                            </div>
                            <div class="row">
                                <div class="col-3 mt-3"></div>
                                <div class="col-9 mt-3 mb-3">
                                    <button id="btnFetch" class="cmt-btn cmt-btn-size-md cmt-btn-shape-round cmt-btn-style-border cmt-btn-color-skincolor" type="submit">Подписаться</button>
                                </div> 									
                            </div>
                            <input type="hidden" name="g-recaptcha-response" id="recaptchaResponse" />
                        <script src="https://www.google.com/recaptcha/api.js?render=6LfddtUZAAAAAELCRiYyqMJSTIeYCNHvU7E5_xbP"></script>
                        <script>		
							$('#jobSubscribe').on("submit", function(e) {
                                const form = this;
								e.preventDefault(); 
								$("#btnFetch").prop("disabled", true);
								$("#btnFetch").html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Отправка...');
								grecaptcha.ready(function () {
									grecaptcha.execute('6LfddtUZAAAAAELCRiYyqMJSTIeYCNHvU7E5_xbP', { action: 'contact' }).then(async function (token) {
										var recaptchaResponse = document.getElementById('recaptchaResponse');
										recaptchaResponse.value = token;                                        
                                        try{
                                            const data = new FormData(form);                                            
                                            const _response = await(await fetch(`/job/subscribe`, {
                                                method: "POST",
                                                body: data
                                            })).json();       
                                            var type = _response.type;
											var error = _response.error;
											var errorMessage = '';
											var success = _response.success;
											if(type != "success") {
                                                for(var k in error) {
                                                    errorMessage = errorMessage + error[k];
                                                    console.log(errorMessage);
                                                }
												Swal.fire('Ошибка', errorMessage, 'error');
												$("#btnFetch").prop("disabled", false);
												$("#btnFetch").html('Отправить');		
											}
											else {
												Swal.fire('Информация', success, 'success');
                                                $("#btnFetch").prop("disabled", false);
												$("#btnFetch").html('Отправить');
												//$('#btnFetch').remove();
											}                                            
                                        } catch(e){
                                            const error = e.message;
                                            $("#btnFetch").prop("disabled", false);
											$("#btnFetch").html('Отправить');	
											Swal.fire('Ошибка', error, 'error');
                                        }                                        
									});
								});
                                
							});
						</script>        
                        </form>           
                    </div>
                </div>	
		    </div>
	    </div>                                           
    </div>
{% endblock content %}
                                    