{% extends "_layout/content_with_sidebar_left.html.twig" %}

{% block sidebar %}
    <div class="block widget-recent spaceBlock news-left-block">
        <div class="block-content news-left-block-content">
            {{ categories('job', 'Все вакансии') }}
        </div>
    </div>
    <div class="widget-area mt_15 mb-3">
        {% include '_widget/widget_callback_left.html.twig' %}
    </div>
{% endblock sidebar %}

{% block title %}
    <h1 class="mt-3 h1-page-title">
        {{ title }}
    </h1>
{% endblock title %}

{% block breadcrumbs %}
    <ul id="breadcrumbs-two" class="breadcrumb">
    {% for bread in breadcrumbs %}       
        {% if loop.last %}
            <li class="active"><span>{{ bread.name }}</span></li>
        {% else %}
            <li><a href="{{ bread.url }}"> {{ bread.name }}</a></li>
        {% endif %}       
    {% endfor %}
    </ul>
{% endblock breadcrumbs %}

{% block content %}
    <style>
        a:hover {
             text-decoration: none !important;
         }
        .toggle-content > p{
             line-height: 1.2;
        }
    </style>  
    <div class="row">
        <div class="col-12 mt-3">
         <div class="section-title">
                            <div class="title-header">
                                <h5>Добро пожаловать в АТРИ-ЭНЕРГО</h5>
                                <h2 class="title">Присоединяйся <strong>к нашей команде</strong></h2>
                            </div>
                        </div>
            <div class="card">		
                <div class="card-body card-body-cert">	
                    <div class="pt-15 pr-30 mb_30 res-991-pr-0 res-991-pt-30">                       
                        <p style="line-height: 1.5;">Наша компания специализируется на установке систем водоснабжения, систем отопления <br> ООО «Атри-Энерго» - динамично развивающаяся многопрофильная компания, направлением деятельности которой является внедрение и применение современных технологий для решения инженерных задач в области систем тепловодоснабжения.</p>
                        <div class="section-title">
                            <div class="title-header">                        
                                <h4 class="title text-uppercase">Почему именно <strong>мы?</strong></h4>
                            </div>
                        </div>
                        <div class="pt-10 pr-15 res-991-pr-0">
                            <div class="featured-icon-box icon-align-before-content style2">
                                <div class="featured-icon">
                                    <div class="cmt-icon cmt-icon_element-border cmt-icon_element-color-skincolor cmt-icon_element-size-lg cmt-icon_element-style-square"> 
                                        <i class="fad fa-users"></i>
                                    </div>
                                </div>
                                <div class="featured-content">
                                    <div class="featured-title">
                                        <h5 class="text-red">Дружный коллектив</h5>
                                    </div>
                                    <div class="featured-desc">
                                        <p>Большую часть своей жизни мы проводим на работе, поэтому самое важное для нас - дружный коллектив. Каждый сотрудник - настоящий участник команды, которая ежедневно работает над развитием себя и компании.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="featured-icon-box icon-align-before-content style2">
                                <div class="featured-icon">
                                    <div class="cmt-icon cmt-icon_element-border cmt-icon_element-color-skincolor cmt-icon_element-size-lg cmt-icon_element-style-square"> 
                                        <i class="fad fa-shield-check"></i>
                                    </div>
                                </div>
                                <div class="featured-content">
                                    <div class="featured-title">
                                        <h5 class="text-red">Под защитой</h5>
                                    </div>
                                    <div class="featured-desc">
                                        <p>Мы работаем по трудовому кодексу, кроме того компания всегда заботится о своих сотрудниках и помогает им в сложных ситуациях, кроме того компания на рынке уже 9 лет, что явлется показателем стабильности и надежности.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="featured-icon-box icon-align-before-content style2">
                                <div class="featured-icon">
                                    <div class="cmt-icon cmt-icon_element-border cmt-icon_element-color-skincolor cmt-icon_element-size-lg cmt-icon_element-style-square"> 
                                        <i class="fad fa-gift"></i>
                                    </div>
                                </div>
                                <div class="featured-content">
                                    <div class="featured-title">
                                        <h5 class="text-red">Приятные бонусы</h5>
                                    </div>
                                    <div class="featured-desc">
                                        <p>У нас есть различные поощрения и бонусы для успешных сотрудников. Наши сотрудники постоянно посещают выставки и семинары. Мы оплачиваем различные курсы и тренинги для повышения квалификации. Также мы проводим различные мероприятия к корпоративы.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>	
		    </div>
	    </div>
        <div class="col-12 mt-3">
            <div class="section-title" style="margin-bottom: -5px;">
                <div class="title-header">
                    <h5>Смотри, какие есть направления</h5>
                    <h2 class="title">Вакансии по направлениям</h2>
                </div>
            </div>
        </div> 
        {% for cat in categories %}  
        <div class="col-lg-6 col-md-4 col-sm-12">                
            <div class="featured-icon-box icon-align-top-content style4 bor_rad_5">
                <div class="bg_icon" style="top: 60px;"><i class="fad fa-{{ cat.icon }}"></i></div>
                <div class="featured-icon">
                    <div class="cmt-icon cmt-icon_element-onlytxt cmt-icon_element-color-skincolor cmt-icon_element-size-lg">
                        <i class="fal fa-{{ cat.icon }}"></i>
                    </div>
                </div>
                <div class="featured-content">
                    <div class="content-inner">
                        <div class="featured-title">
                            <h5>{{ cat.name }}</h5>
                        </div>
                        <div class="featured-desc">
                            <p style="line-height: 1.2;">{{ cat.description }}</p>
                        </div>
                    </div>
                    <a class="cmt-btn btn-inline cmt-btn-size-md cmt-icon-btn-left cmt-btn-color-skincolor" href="{{ cat.url }}" title=""><i class="fa fa-minus"></i>Посмотреть вакансии</a>
                </div>
            </div>
        </div>  
        {% endfor %}
        <div class="col-lg-12 col-md-12 col-sm-12 mt-3">   
            <div class="section-title" style="margin-bottom: -5px;">
                <div class="title-header">
                    <h5>Давай работать вместе</h5>
                    <h2 class="title">Не нашли подходящей вакансии?</h2>
                </div>
            </div>
            <div class="row mt-3 mb-3">
                <div class="col-sm-4 m-t-xs">
                    <p style="line-height: 1.2;" class="text-large m-b-0">
                        Напишите несколько слов о себе и о том, какая вакансия может быть вам интересна.
                        <br><br>
                        <a href="/job/send" class="cmt-btn cmt-btn-size-md cmt-btn-shape-round cmt-btn-style-border cmt-btn-color-skincolor">Отправить резюме</a>
                    </p>
                </div>
                <div class="col-sm-4 m-t-xs">
                    <p style="line-height: 1.2;" class="text-large m-b-0">
                        Подпишитесь и получайте информацию о новых вакансиях на свою почту.                                                                                    
                        <br><br>
                        <a href="/job/subscribe" class="cmt-btn cmt-btn-size-md cmt-btn-shape-round cmt-btn-style-border cmt-btn-color-skincolor">Подписаться</a>
                    </p>
                </div>
                <div class="col-sm-4 m-t-xs">
                    <p style="line-height: 1.2;" class="text-large">Задайте вопрос менеджеру по телефону +7 (3412) 908-123 или напишите письмо.</p>
                    <a href="/feedback?type=3" class="cmt-btn cmt-btn-size-md cmt-btn-shape-round cmt-btn-style-border cmt-btn-color-skincolor">Написать письмо</a>
                </div>
            </div>     
        </div>

        {% include 'job/faq.html.twig' %}
    </div>
{% endblock content %}
                                    