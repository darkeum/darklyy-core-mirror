{% extends "_layout/content_with_sidebar_left.html.twig" %}

{% block sidebar %}
    <div class="block widget-recent spaceBlock news-left-block">
        <div class="block-content news-left-block-content">
           
        </div>
    </div>
    <div class="widget-area mt_15 mb-3">
        {% include '_widget/widget_callback_left.html.twig' %}
    </div>
{% endblock sidebar %}

{% block title %}
    <h1 class="mt-3 h1-page-title">{{ title }}</h1>
{% endblock title %}

{% block breadcrumbs %}
    {% include 'breadcrumbs.html.twig' %}
{% endblock breadcrumbs %}

{% block content %}
<style>
	a:hover {
        text-decoration: none !important;
    }
	.cmt-list.cmt-list-style-icon li i {
    	position: absolute;
    	left: auto;
    	top: 2px;
    	font-weight: 700;
	}
  	.block-title-widget-2 {
    	color: #222;
    	font-size: 20px;
    	text-transform: uppercase;
    	margin-bottom: 10px;
    	display: block;
    	font-weight: bold;
	}
	.title-h2 {
		font-size: 17px;
		font-family: Verdana, sans-serif;
		color: #FA381D;
		padding: 0;		
		display: block;	
		font-style: normal;
	}
	.title-border {		
		padding-left: 10px;
		vertical-align: middle;
		border-left: 2px solid #FA381D;
		margin-bottom: 15px;
		margin-top: 10px;
		display: block;	
		font-style: normal;
	}
	.title-description{
		margin-top: -8px;
	}	
	.ah2:hover {
		text-decoration: none;	
	}	
	img.img_left {
    	display: block;
    	float: right;
    	padding: 3px;
    	border: 1px solid #E2E3E5 !important;
		max-width: 214px !important;
	}
	
</style>
<div class="row mt-3">
{% if items is empty %}   
<div class="col-md-12 mb-3">
	<div class="alert alert-warning alert-lg w-100 mt-3" role="alert">
		<h4 class="no-margin no-padding">Информация</h4>	
		<p>К сожалению по данному запросу акций не найдено, попробуйте зайти позже!</p>	
	</div>
</div>
{% else %}   
{% for item in items %}
<div class="col-md-12 mb-3">
	<div class="card mb-3">
		<div class="card-body card-body-cert">
          	<div class="row">
              	<div class="col-4">
					<a data-fancybox="gallery" href="{{ item.preview.full }}" target="_blank">
						<img class="w-100" title="{{ item.title }}" src="{{ item.preview.full_webp }}" alt="{{ item.title }}">
					</a>
				</div>
              	<div class="col-5 d-flex flex-column" style="border-right: 1px solid #d9d9d9">
                  	<div class="mb-20"><h4><b>{{ item.title }}</b></h4></div>
                  	<div class="mb-20">{{ item.short|raw }}</div>
					<div class="mb-20">				
						{% for tag in item.tags %}
						<a  href="/reviews/tags/{{ tag }}" title="{{ tag }}" class="badge badge-primary mr-2">{{ tag }}</a>
						{% endfor %}   	
					</div>
					<div><strong>Акция действует с {{ item.date_start|date('d.m.Y') }} по {{ item.date_end|date('d.m.Y') }}</strong></div>
				</div>   
              	<div class="col-3 align-self-center">
				  	{% set first = item.sales.sales_detail|first %}
					<img class="w-100" title="{{ first.catalog.title }}" src=" {{ first.catalog.preview }}" alt="{{ first.catalog.title  }}">
					<p style="">{{ first.catalog.title  }}</p>
                  	<a href="{{ item.url }}">Еще {{ item.sales.sales_detail|length}}  товаров <i class="fas fa-long-arrow-alt-right"></i></a>
              	</div>
          	</div>
        </div>
    </div>
</div>
{% endfor %} 
<div class="col-md-12 mb-3">  
	{{ items.links|raw }}
</div>
{% endif %}
</div>	
{% endblock content %}
                                    