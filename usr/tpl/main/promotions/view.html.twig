{% extends "_layout/content_with_sidebar_left.html.twig" %}

{% block sidebar %}
    <div class="block widget-recent spaceBlock news-left-block">
        <div class="block-content news-left-block-content">
            {{ categories('reviews', 'Все отзывы') }}
        </div>
    </div>
    <div class="widget-area mt_15 mb-3">
        {% include '_widget/widget_callback_left.html.twig' %}
    </div>
{% endblock sidebar %}

{% block title %}
    <h1 class="mt-3 h1-page-title">
        {{ title }}
    </h1>
{% endblock title %}

{% block breadcrumbs %}
    <ul id="breadcrumbs-two" class="breadcrumb">
    {% for bread in breadcrumbs %}       
        {% if loop.last %}
            <li class="active"><span>{{ bread.name }}</span></li>
        {% else %}
            <li><a href="{{ bread.url }}"> {{ bread.name }}</a></li>
        {% endif %}       
    {% endfor %}
    </ul>
{% endblock breadcrumbs %}

{% block content %}  

<style>
	a:hover {
        text-decoration: none !important;
    }
	.cmt-list.cmt-list-style-icon li i {
    	position: absolute;
    	left: auto;
    	top: 2px;
    	font-weight: 700;
	}
  	.block-title-widget-2 {
    	color: #222;
    	font-size: 20px;
    	text-transform: uppercase;
    	margin-bottom: 10px;
    	display: block;
    	font-weight: bold;
	}
	.title-h2 {
		font-size: 17px;
		font-family: Verdana, sans-serif;
		color: #FA381D;
		padding: 0;		
		display: block;	
		font-style: normal;
	}
	.title-border {		
		padding-left: 10px;
		vertical-align: middle;
		border-left: 2px solid #FA381D;
		margin-bottom: 15px;
		margin-top: 10px;
		display: block;	
		font-style: normal;
	}
	.title-description{
		margin-top: -8px;
	}	
	.ah2:hover {
		text-decoration: none;	
	}	
	img.img_left {
    	display: block;
    	float: right;
    	padding: 3px;
    	border: 1px solid #E2E3E5 !important;
		max-width: 214px !important;
	}

</style>
<div class="row">
	<div class="col-md-12 mb-3 mt-3">
		<div class="card">		
			<div class="card-body card-body-cert">
				<div class="row">
					<div class="col-6">
				  		<a data-fancybox="gallery" href="{{ item.preview.full }}" target="_blank">
					  		<img class="w-100" title="{{ item.title }}" src="{{ item.preview.full_webp }}" alt="{{ item.title }}">					  
				  		</a>
						<div class="mt-3"><strong>Акция действует с {{ item.date_start|date('d.m.Y') }} по {{ item.date_end|date('d.m.Y') }}</strong></div>
			  		</div>
					<div class="col-6 d-flex flex-column">
						<div class="mb-20"><h4><b>{{ item.title }}</b></h4></div>
						<div class="mb-20">{{ item.short|raw }}</div>
				  		<div class="mb-20">				
					 		{% for tag in item.tags %}
					 		<a  href="/promotions/tags/{{ tag }}" title="{{ tag }}" class="badge badge-primary mr-2">{{ tag }}</a>
					 		{% endfor %}   	
				  		</div>				  
			  		</div>  
					<div class="col-md-12 ">	
						<div class="tableResponsiveProfile pl-10 pr-10">		 
							<div class="profileWrapTableOrderH">
								<div></div>
								<div><b>Наименование</b></div>
								<div><b>Артикул</b></div>	
								<div><b>Цена</b></div>
								<div><b>Цена по акции</b></div>
								<div><b>Наличие</b></div>	
								<div></div>							
							</div>
							{% for p in promo %}
							<div class="orderZk1 pBlock1 profileLink" href="#">
								<div class="profileWrapTableOrderContent">
									<div class="orderZk1 pBlock1 ml-10"><img src="{{ p.preview }}" style="width: 100%;"/></div>		
									<div class="orderZk2 pBlock1">{{ p.title }}</div>				
									<div class="orderZk3 pBlock1">{{ p.sku }}</div>
									<div class="orderZk4 pBlock1" style="text-decoration: line-through;">{{ p.price }} руб.</div>
									<div class="orderZk4 pBlock1" style="color: red !important;">{{ p.discount_price }} руб.</div>
									<div class="orderZk5 pBlock1">{{ p.count }}</div>
									<div class="orderZk5 pBlock1"><button type="button" class="btn btn-dark btm-sm"><i class="fal fa-cart-plus"></i></button></div>
								</div>
							</div>
							{% endfor %}   	
						</div>	 
				  	</div>
				</div>
			</div>
		</div>
	</div>
</div>
<style>
	.profileWrapTableOrderH {
    grid-template-columns: 48px 1fr 80px 130px 130px 80px 60px !important;
}
.profileWrapTableOrderContent {
    grid-template-columns: 48px 1fr 80px 130px 130px 80px 60px!important;
}
</style>
{% endblock content %}