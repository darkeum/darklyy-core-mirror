    "conflict": {
        "laravel/framework": "*"
    },
    "autoload": {
        "files": [
            "src/boot/Support/helpers.php",
            "src/boot/Autoloader.class.php"
        ],
        "psr-4": {
            "Boot\\": "src/boot/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "pris/module-installer": true,
            "pris/darklyy-module-installer": true
        }
    },
    "require-dev": {
        "darkeum/darklyy-php-debugbar": "^1.0",
        "mockery/mockery": "^1.5"
    },
    "scripts": {
        "post-autoload-dump": [
            "Boot\\App\\ComposerScripts::postAutoloadDump",
            "@php darksander package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php darksander key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "merge-plugin": {
            "include": [
                "usr/module/Vendor/*/composer.json"
            ],
            "recurse": true,
            "replace": false,
            "merge-dev": true,
            "merge-extra": false,
            "merge-extra-deep": false,
            "merge-scripts": true
        }
    },
    "minimum-stability": "dev"
}
