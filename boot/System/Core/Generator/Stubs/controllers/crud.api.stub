namespace {{container-name}}\UI\{{user-interface}}\Controllers;

use {{container-name}}\UI\{{user-interface}}\Requests\Create{{model}}Request;
use {{container-name}}\UI\{{user-interface}}\Requests\Delete{{model}}Request;
use {{container-name}}\UI\{{user-interface}}\Requests\GetAll{{models}}Request;
use {{container-name}}\UI\{{user-interface}}\Requests\Find{{model}}ByIdRequest;
use {{container-name}}\UI\{{user-interface}}\Requests\Update{{model}}Request;
use {{container-name}}\UI\{{user-interface}}\Transformers\{{model}}Transformer;
use {{container-name}}\Actions\Create{{model}}Action;
use {{container-name}}\Actions\Find{{model}}ByIdAction;
use {{container-name}}\Actions\GetAll{{models}}Action;
use {{container-name}}\Actions\Update{{model}}Action;
use {{container-name}}\Actions\Delete{{model}}Action;
use Boot\Abstracts\Controllers\{{base-controller}};
use Boot\System\Http\JsonResponse;

class {{class-name}} extends {{base-controller}}
{
    public function create{{model}}(Create{{model}}Request $request): JsonResponse
    {
        ${{entity}} = app(Create{{model}}Action::class)->run($request);
        return $this->created($this->transform(${{entity}}, {{model}}Transformer::class));
    }

    public function find{{model}}ById(Find{{model}}ByIdRequest $request): array
    {
        ${{entity}} = app(Find{{model}}ByIdAction::class)->run($request);
        return $this->transform(${{entity}}, {{model}}Transformer::class);
    }

    public function getAll{{models}}(GetAll{{models}}Request $request): array
    {
        ${{entities}} = app(GetAll{{models}}Action::class)->run($request);
        return $this->transform(${{entities}}, {{model}}Transformer::class);
    }

    public function update{{model}}(Update{{model}}Request $request): array
    {
        ${{entity}} = app(Update{{model}}Action::class)->run($request);
        return $this->transform(${{entity}}, {{model}}Transformer::class);
    }

    public function delete{{model}}(Delete{{model}}Request $request): JsonResponse
    {
        app(Delete{{model}}Action::class)->run($request);
        return $this->noContent();
    }
}
